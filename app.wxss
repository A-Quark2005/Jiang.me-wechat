page {
  min-height: 100vh;
  background: #f7f8fa;
  color: #333333;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

view,
text,
button,
input,
textarea,
switch,
image,
picker,
label,
radio-group {
  box-sizing: border-box;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 500;
  text-align: center;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 0 32rpx 36rpx;
  background: #f7f8fa;
}

.page-with-bar {
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
}

.page-plain {
  padding-top: 0;
}

.native-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  height: calc(88rpx + env(safe-area-inset-top));
  padding: env(safe-area-inset-top) 24rpx 16rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f3f4f6;
}

.native-header-spacer {
  height: calc(88rpx + env(safe-area-inset-top));
}

.native-header-title {
  font-size: 36rpx;
  line-height: 54rpx;
  font-weight: 400;
  color: #333333;
}

.native-header-back,
.native-header-action {
  position: absolute;
  bottom: 16rpx;
  display: flex;
  align-items: center;
  min-height: 32rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.native-header-back {
  left: 24rpx;
  color: #333333;
}

.native-header-action {
  right: 24rpx;
  color: #0071fe;
}

.surface-card,
.list-card {
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.surface-card {
  margin-top: 16rpx;
  padding: 24rpx 28rpx;
}

.section-title,
.row-title {
  font-size: 32rpx;
  line-height: 1.5;
  font-weight: 500;
  color: #333333;
}

.section-subtitle,
.row-meta,
.muted,
.soft-note {
  font-size: 24rpx;
  line-height: 1.5;
  color: #b0b8c9;
}

.soft-note {
  text-align: center;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.row-main {
  min-width: 0;
  flex: 1;
}

.feature-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.feature-icon,
.icon-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #f0f5ff;
  flex-shrink: 0;
}

.feature-icon-image,
.icon-tile-image {
  width: 44rpx;
  height: 44rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.status-ok {
  color: #0071fe;
  background: #eef5ff;
}

.status-warn {
  color: #f59e0b;
  background: #fff4d6;
}

.status-danger {
  color: #ff4d4f;
  background: #fff1f0;
}

.primary-button {
  color: #ffffff;
  background: #0071fe;
}

.secondary-button {
  color: #333333;
  background: #f0f0f0;
}

.ghost-button {
  color: #0071fe;
  background: #eef5ff;
}

.danger-button {
  color: #ffffff;
  background: #ff4d4f;
}

.outline-button {
  color: #0071fe;
  background: #ffffff;
  border: 1rpx solid #0071fe;
}

.action-button {
  margin-top: 18rpx;
}

.full-button {
  width: 100%;
}

.field {
  margin-top: 20rpx;
}

.field:first-child {
  margin-top: 0;
}

.field-label {
  margin-bottom: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #1a1a1a;
}

.input,
.textarea {
  width: 100%;
  background: #ffffff;
  color: #333333;
}

.textarea {
  min-height: 220rpx;
  line-height: 1.7;
}

.error-box,
.success-box,
.empty-box {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.error-box {
  color: #ff4d4f;
  background: #fff1f0;
}

.success-box {
  color: #0071fe;
  background: #eef5ff;
}

.empty-box {
  color: #b0b8c9;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.segmented-strip {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  overflow-x: auto;
  white-space: nowrap;
}

.segment-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 132rpx;
  height: 68rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  text-align: center;
  font-size: 26rpx;
  line-height: 1.4;
  color: #666666;
}

.segment-chip-active {
  background: #0071fe;
  color: #ffffff;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #f7f8fa;
}

.stat-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 132rpx;
  padding: 18rpx 12rpx;
  text-align: center;
  border-right: 1rpx solid #ebebeb;
}

.stat-box:last-child {
  border-right: 0;
}

.stat-value {
  font-size: 42rpx;
  line-height: 1.05;
  color: #0071fe;
  font-weight: 500;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #b0b8c9;
}

.arrow-light {
  color: #cccccc;
  font-size: 28rpx;
  line-height: 1;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 12rpx 16rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f3f4f6;
}

.button-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.safe-bottom-pad {
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.tappable:active {
  opacity: 0.82;
}

.tap-target {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 20rpx;
}

.tap-target-block {
  display: flex;
  align-items: center;
  min-height: 88rpx;
}

.tap-target-inline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
}
