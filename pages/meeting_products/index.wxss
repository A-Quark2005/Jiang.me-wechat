.products-page {
  padding-top: 14rpx;
}

.products-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-top: 18rpx;
  padding-bottom: 24rpx;
}

.product-card {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  min-height: 178rpx;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #ebebeb;
}

.product-icon-wrap {
  flex-shrink: 0;
}

.product-icon-image {
  width: 88rpx;
  height: 88rpx;
}

.product-main {
  min-width: 0;
  flex: 1;
  padding-top: 2rpx;
}

.product-title {
  font-size: 30rpx;
  line-height: 45rpx;
  font-weight: 500;
  color: #333333;
}

.product-feature {
  font-size: 24rpx;
  line-height: 36rpx;
  color: #b0b8c9;
}

.product-feature:first-of-type {
  margin-top: 6rpx;
}

.product-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  flex-shrink: 0;
  padding-top: 2rpx;
}

.product-price {
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  line-height: 1;
  font-weight: 600;
  color: #333333;
}

.product-price-unit {
  font-size: 20rpx;
  line-height: 34rpx;
}

.product-price-value {
  font-size: 28px;
  line-height: 42rpx;
}

.product-buy {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 88rpx;
  padding: 0 8rpx;
  font-size: 16px;
  line-height: 1.4;
  color: #0071fe;
}

.product-buy-icon {
  width: 18px;
  height: 18px;
}

.products-note {
  padding-top: 4rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
  color: #9ca3af;
}
