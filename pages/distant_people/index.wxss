.distant-page {
  min-height: 100vh;
  padding: 18rpx 16px 152rpx;
  box-sizing: border-box;
}

.distant-filter-strip {
  position: sticky;
  top: 0;
  z-index: 10;
  margin: -18rpx -32rpx 16rpx;
  padding: 16rpx 32rpx 18rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #eef2f7;
}

.distant-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.distant-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 144rpx;
  padding: 24rpx 28rpx;
}

.distant-logo {
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
}

.distant-logo.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #eef5ff;
  color: #0071fe;
  font-size: 32rpx;
  font-weight: 600;
}

.distant-main {
  min-width: 0;
  flex: 1;
}

.distant-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  line-height: 42rpx;
  color: #152033;
  font-weight: 600;
}

.distant-meta,
.distant-domain {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #9ca3af;
}

.distant-meta {
  margin-top: 4rpx;
}

.distant-domain {
  color: #0071fe;
}

.distant-empty {
  min-height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b0b8c9;
  font-size: 26rpx;
}

.distant-arrow {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
}

.demand-entry-button {
  position: fixed;
  right: 86rpx;
  bottom: calc(250rpx + env(safe-area-inset-bottom));
  z-index: 20;
  width: 132rpx;
  height: 132rpx;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: #0071fe;
  box-shadow: 0 16rpx 36rpx rgba(0, 113, 254, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  overflow: hidden;
}

.demand-entry-button-hover {
  background: #0065e5;
  transform: translateY(2rpx);
}

.demand-entry-icon {
  width: 58rpx;
  height: 58rpx;
}
