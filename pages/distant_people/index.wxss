.distant-page {
  min-height: 100vh;
  padding: 18rpx 16px 40rpx;
  box-sizing: border-box;
}

.social-entry-card {
  margin-bottom: 18rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.06);
}

.social-entry-title {
  font-size: 34rpx;
  line-height: 48rpx;
  color: #152033;
  font-weight: 700;
}

.social-entry-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #9ca3af;
}

.social-entry-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

.social-entry-action {
  min-width: 0;
  padding: 20rpx 22rpx;
  border-radius: 12rpx;
  background: #f5f7fb;
  box-sizing: border-box;
}

.social-entry-action.active {
  background: #eaf3ff;
}

.social-entry-action-title {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #152033;
  font-weight: 600;
}

.social-entry-action.active .social-entry-action-title {
  color: #0071fe;
}

.social-entry-action-desc {
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #9ca3af;
}

.distant-filter-strip {
  position: sticky;
  top: 0;
  z-index: 10;
  margin: 0 -32rpx 20rpx;
  padding: 16rpx 32rpx 18rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #eef2f7;
}

.distant-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.distant-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 144rpx;
  padding: 24rpx 28rpx;
}

.distant-logo {
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
}

.distant-logo.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #eef5ff;
  color: #0071fe;
  font-size: 32rpx;
  font-weight: 600;
}

.distant-main {
  min-width: 0;
  flex: 1;
}

.distant-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  line-height: 42rpx;
  color: #152033;
  font-weight: 600;
}

.distant-meta,
.distant-domain {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #9ca3af;
}

.distant-meta {
  margin-top: 4rpx;
}

.distant-domain {
  color: #0071fe;
}

.distant-empty {
  min-height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b0b8c9;
  font-size: 26rpx;
}

.distant-arrow {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
}
