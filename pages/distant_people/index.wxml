<view class="page page-plain distant-page">
  <view class="social-entry-card">
    <view class="social-entry-copy">
      <view class="social-entry-title">找人，也可以发需求</view>
      <view class="social-entry-desc">按认证组织发现公开资料，或发布需求收集简历</view>
    </view>
    <view class="social-entry-actions">
      <view class="social-entry-action active">
        <view class="social-entry-action-title">找人</view>
        <view class="social-entry-action-desc">查看公开资料</view>
      </view>
      <view class="social-entry-action tappable" bindtap="openDemandEntry">
        <view class="social-entry-action-title">需求广场</view>
        <view class="social-entry-action-desc">寻找/发布需求</view>
      </view>
    </view>
  </view>

  <view class="segmented-strip distant-filter-strip">
    <view class="distant-filter-groups">
      <view
        wx:for="{{groups}}"
        wx:key="key"
        class="segment-chip tappable {{item.className}}"
        data-group="{{item.key}}"
        bindtap="switchGroup"
      >
        {{item.label}}
      </view>
    </view>
    <view class="distant-search-button tappable" bindtap="openSearch" aria-label="搜索">
      <image class="distant-search-icon" src="/assets/ui/search.svg" mode="aspectFit"></image>
    </view>
  </view>

  <view wx:if="{{loading}}" class="surface-card">
    <view class="section-title">正在读取组织</view>
  </view>

  <view wx:elif="{{errorMessage}}" class="surface-card">
    <view class="section-title">读取失败</view>
    <view class="error-box">{{errorMessage}}</view>
    <button class="primary-button action-button" bindtap="loadOrganizations">重新加载</button>
  </view>

  <view wx:else class="distant-list">
    <view wx:if="{{visibleOrganizations.length === 0}}" class="surface-card distant-empty">暂无可查看组织</view>
    <view wx:for="{{visibleOrganizations}}" wx:key="id" class="surface-card distant-card tappable" data-id="{{item.id}}" bindtap="openOrganization">
      <image wx:if="{{item.logoUrl}}" class="distant-logo" src="{{item.logoUrl}}" mode="aspectFit"></image>
      <view wx:else class="distant-logo fallback">{{item.initial}}</view>
      <view class="distant-main">
        <view class="distant-title">{{item.name}}</view>
        <view class="distant-meta">{{item.description}}</view>
        <view class="distant-domain">{{item.domainText}}</view>
      </view>
      <image class="distant-arrow" src="/assets/ui/arrow-light.svg" mode="aspectFit"></image>
    </view>
  </view>
</view>
