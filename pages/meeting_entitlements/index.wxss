.action-button {
  margin-top: 22rpx;
}

.mini-button {
  min-width: 112rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
}

.entitlement-row,
.plan-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #f7f9fc;
}

.plan-card {
  border: 2rpx solid transparent;
}

.plan-selected {
  border-color: #1677ff;
  background: #eef4ff;
}

.plan-disabled {
  opacity: 0.55;
}

.plan-main {
  min-width: 0;
  flex: 1;
}

.plan-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.plan-desc {
  margin-top: 10rpx;
  line-height: 1.45;
}

.row-title {
  font-weight: 700;
  color: #182033;
}

.price {
  color: #1677ff;
  font-size: 34rpx;
  font-weight: 700;
}

.note-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef2f7;
  color: #475467;
  line-height: 1.5;
}

.note-row:last-child {
  border-bottom: 0;
}

.buy-bar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 220rpx;
  gap: 18rpx;
  align-items: center;
  box-sizing: border-box;
  overflow: hidden;
}

.buy-bar > view {
  min-width: 0;
}

.selected-title {
  margin-top: 6rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.buy-button {
  width: 100%;
  min-width: 0;
  max-width: 220rpx;
  box-sizing: border-box;
  height: 82rpx;
  line-height: 82rpx;
  margin: 0;
  padding: 0 12rpx;
  font-size: 28rpx;
  justify-self: end;
}
