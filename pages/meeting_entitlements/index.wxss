.entitlements-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-top: 18rpx;
  padding-left: 0;
  padding-right: 0;
  padding-bottom: 0;
  box-sizing: border-box;
}

.entitlements-pending-card {
  margin: 0 16px 12rpx;
}

.entitlements-orders-card {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 108rpx;
  margin: 0 16px 12rpx;
  background: #0071fe;
}

.entitlements-orders-title {
  font-size: 30rpx;
  line-height: 1.45;
  color: #ffffff;
  text-align: center;
}

.entitlements-pending-button {
  margin-top: 20rpx;
}

.entitlements-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 514rpx;
  padding-top: 160rpx;
}

.unfinished-demands-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 0 16px;
}

.unfinished-demand-card {
  margin: 0;
}

.unfinished-demand-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.unfinished-demand-copy {
  min-width: 0;
  flex: 1;
}

.unfinished-demand-title {
  font-size: 30rpx;
  line-height: 1.45;
  color: #333333;
}

.unfinished-demand-summary {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #6b7280;
}

.unfinished-demand-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #b0b8c9;
}

.unfinished-demand-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
}

.unfinished-demand-badge {
  min-width: 120rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eef5ff;
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
  color: #0071fe;
}

.unfinished-demand-status {
  font-size: 22rpx;
  line-height: 30rpx;
  color: #0f9d58;
}

.entitlements-empty-image {
  width: 139px;
  height: 108px;
}

.entitlements-empty-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: #b0b8c9;
  text-align: center;
}

.entitlements-empty-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  margin-top: 28rpx;
  padding: 0 42rpx;
  border-radius: 999rpx;
  background: #111111;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
  color: #ffffff;
}

.entitlements-history-row {
  display: flex;
  justify-content: flex-end;
  margin: 52rpx 16px 0;
}

.entitlements-history-button {
  display: inline-flex;
  align-items: center;
  gap: 3.99px;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #e9ebef;
  font-size: 28rpx;
  line-height: 1.4;
  color: #666b76;
}

.entitlements-history-arrow {
  width: 14px;
  height: 14px;
  filter: grayscale(1) brightness(0.45);
}

.entitlements-recommend {
  margin: 18rpx 16px 0;
}

.entitlements-recommend-fixed {
  margin-top: auto;
  padding-top: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.entitlements-divider-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.entitlements-divider {
  width: 142rpx;
  height: 1rpx;
  background: #b0b8c9;
}

.entitlements-divider-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #52565e;
}

.entitlements-recommend-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  min-height: 160rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #ebebeb;
}

.entitlements-recommend-icon-image {
  width: 44px;
  height: 44px;
  flex-shrink: 0;
}

.entitlements-recommend-title {
  font-size: 30rpx;
  line-height: 1.45;
  color: #333333;
}

.entitlements-recommend-meta {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #b0b8c9;
}

.entitlements-recommend-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3.99px;
  flex-shrink: 0;
  min-height: 88rpx;
  padding-left: 8rpx;
  font-size: 28rpx;
  line-height: 1.4;
  color: #0071fe;
}

.entitlements-arrow-icon {
  width: 15.98px;
  height: 15.98px;
}
