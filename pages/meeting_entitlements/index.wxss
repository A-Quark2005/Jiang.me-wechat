.entitlements-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-top: 0;
  padding-left: 0;
  padding-right: 0;
  padding-bottom: 0;
  box-sizing: border-box;
}

.entitlements-content {
  min-height: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.entitlements-orders-card {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 108rpx;
  margin: 0 16px 12rpx;
  background: #0071fe;
}

.entitlements-orders-title {
  font-size: 30rpx;
  line-height: 1.45;
  color: #ffffff;
  text-align: center;
}

.entitlements-empty {
  position: relative;
  min-height: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.entitlements-empty-main {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.entitlements-middle {
  min-height: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.entitlements-empty-image {
  width: 278rpx;
  height: 234rpx;
}

.entitlements-empty-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: #b0b8c9;
  text-align: center;
}

.entitlements-empty-button {
  position: absolute;
  left: 50%;
  top: calc(50% + 163rpx);
  transform: translateX(-50%);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 42rpx;
  border-radius: 999rpx;
  background: #111111;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
  color: #ffffff;
}

.entitlements-history-row {
  display: flex;
  justify-content: flex-end;
  margin: 52rpx 16px 0;
}

.entitlements-history-button {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #e9ebef;
  font-size: 28rpx;
  line-height: 1.4;
  color: #666b76;
}

.entitlements-history-arrow {
  width: 28rpx;
  height: 28rpx;
  filter: grayscale(1) brightness(0.45);
}

.entitlements-recommend {
  margin: 18rpx 16px 0;
}

.entitlements-recommend-fixed {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.entitlements-divider-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.entitlements-divider {
  width: 142rpx;
  height: 1rpx;
  background: #b0b8c9;
}

.entitlements-divider-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #52565e;
}

.entitlements-recommend-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  min-height: 160rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #ebebeb;
}

.entitlements-recommend-icon-image {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}

.entitlements-recommend-title {
  font-size: 30rpx;
  line-height: 1.45;
  color: #333333;
}

.entitlements-recommend-meta {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #b0b8c9;
}

.entitlements-recommend-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex-shrink: 0;
  min-height: 88rpx;
  padding-left: 8rpx;
  font-size: 28rpx;
  line-height: 1.4;
  color: #0071fe;
}

.entitlements-arrow-icon {
  width: 32rpx;
  height: 32rpx;
}
