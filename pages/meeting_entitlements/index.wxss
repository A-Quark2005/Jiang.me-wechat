.entitlements-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-top: 18rpx;
  padding-left: 0;
  padding-right: 0;
  padding-bottom: 0;
  box-sizing: border-box;
}

.entitlements-pending-card {
  margin: 0 16px 12rpx;
}

.entitlements-orders-card {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 108rpx;
  margin: 0 16px 12rpx;
  background: #0071fe;
}

.entitlements-orders-title {
  font-size: 30rpx;
  line-height: 1.45;
  color: #ffffff;
  text-align: center;
}

.entitlements-pending-button {
  margin-top: 20rpx;
}

.entitlements-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 514rpx;
  padding-top: 160rpx;
}

.entitlements-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 0 16px;
}

.entitlements-card {
  margin: 0;
}

.entitlements-card-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.entitlements-card-copy {
  min-width: 0;
  flex: 1;
}

.entitlements-card-title {
  font-size: 30rpx;
  line-height: 1.45;
  color: #333333;
}

.entitlements-card-summary {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #6b7280;
}

.entitlements-card-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
}

.entitlements-card-badge {
  min-width: 120rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eef5ff;
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
  color: #0071fe;
}

.entitlements-card-status {
  font-size: 22rpx;
  line-height: 30rpx;
}

.entitlements-card-status.active {
  color: #0f9d58;
}

.entitlements-card-status.inactive {
  color: #9ca3af;
}

.entitlements-empty-image {
  width: 139px;
  height: 108px;
}

.entitlements-empty-text {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #b0b8c9;
}

.entitlements-recommend {
  margin: 18rpx 16px 0;
}

.entitlements-recommend-fixed {
  margin-top: auto;
  padding-top: 24rpx;
  padding-bottom: calc(8rpx + env(safe-area-inset-bottom));
}

.entitlements-divider-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.entitlements-divider {
  width: 142rpx;
  height: 1rpx;
  background: #b0b8c9;
}

.entitlements-divider-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #52565e;
}

.entitlements-recommend-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  min-height: 160rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #ebebeb;
}

.entitlements-recommend-icon-image {
  width: 44px;
  height: 44px;
  flex-shrink: 0;
}

.entitlements-recommend-title {
  font-size: 30rpx;
  line-height: 1.45;
  color: #333333;
}

.entitlements-recommend-meta {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #b0b8c9;
}

.entitlements-recommend-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3.99px;
  flex-shrink: 0;
  min-height: 88rpx;
  padding-left: 8rpx;
  font-size: 28rpx;
  line-height: 1.4;
  color: #0071fe;
}

.entitlements-arrow-icon {
  width: 15.98px;
  height: 15.98px;
}
