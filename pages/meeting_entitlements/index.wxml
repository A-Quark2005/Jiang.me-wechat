<view class="page page-with-bar page-plain entitlements-page">
  <view wx:if="{{loading}}" class="surface-card">
    <view class="section-title">正在读取权益</view>
    <view class="section-subtitle">请稍候。</view>
  </view>

  <view wx:elif="{{errorMessage && entitlements.length === 0}}" class="surface-card">
    <view class="error-box">{{errorMessage}}</view>
    <button class="primary-button action-button" bindtap="loadPage">重新加载</button>
  </view>

  <block wx:else>
    <view class="surface-card entitlements-orders-card tappable" bindtap="openOrders">
      <view class="entitlements-orders-title">购买记录</view>
    </view>

    <view wx:if="{{showPendingActivationNotice}}" class="surface-card entitlements-pending-card">
      <view class="section-title">腾讯会议待激活</view>
      <view class="section-subtitle">{{pendingActivationText}}</view>
      <button class="secondary-button entitlements-pending-button" loading="{{sendingActivationInvite}}" bindtap="resendActivationInvite">重发激活链接</button>
    </view>

    <view wx:if="{{entitlementCards.length > 0}}" class="entitlements-list">
      <view wx:for="{{entitlementCards}}" wx:key="id" class="surface-card entitlements-card">
        <view class="entitlements-card-main">
          <view class="entitlements-card-copy">
            <view class="entitlements-card-title">{{item.title}}</view>
            <view class="entitlements-card-summary">{{item.summary}}</view>
          </view>
          <view class="entitlements-card-side">
            <view class="entitlements-card-badge">{{item.badge}}</view>
            <view class="entitlements-card-status {{item.active ? 'active' : 'inactive'}}">{{item.statusText}}</view>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="entitlements-empty">
      <image class="entitlements-empty-image" src="{{sleepImageUrl}}" mode="aspectFit"></image>
      <view class="entitlements-empty-text">{{emptyStateText}}</view>
    </view>

    <view class="entitlements-recommend entitlements-recommend-fixed">
      <view class="entitlements-divider-row">
        <view class="entitlements-divider"></view>
        <view class="entitlements-divider-text">推荐购买</view>
        <view class="entitlements-divider"></view>
      </view>

      <view class="entitlements-recommend-card tappable" bindtap="openReferralInvite">
        <image class="entitlements-recommend-icon-image" src="/assets/ui/referral-invite-icon.png" mode="aspectFit"></image>
        <view class="row-main">
          <view class="entitlements-recommend-title">邀请好友，送24小时权益卡</view>
          <view class="entitlements-recommend-meta">好友激活讲了么账号后可兑现</view>
        </view>
        <view class="entitlements-recommend-action">
          <text>去邀请</text>
          <image class="entitlements-arrow-icon" src="/assets/ui/arrow-light.svg" mode="aspectFit"></image>
        </view>
      </view>

      <view class="entitlements-recommend-card tappable" bindtap="openHourPurchase">
        <image class="entitlements-recommend-icon-image" src="/assets/ui/card-ticket-icon.svg" mode="aspectFit"></image>
        <view class="row-main">
          <view class="entitlements-recommend-title">购买小时卡</view>
          <view class="entitlements-recommend-meta">按小时购买，¥2.50/小时</view>
        </view>
        <view class="entitlements-recommend-action">
          <text>去购买</text>
          <image class="entitlements-arrow-icon" src="/assets/ui/arrow-light.svg" mode="aspectFit"></image>
        </view>
      </view>

      <view class="entitlements-recommend-card tappable" bindtap="openProducts">
        <image class="entitlements-recommend-icon-image" src="/assets/ui/card-ticket-icon.svg" mode="aspectFit"></image>
        <view class="row-main">
          <view class="entitlements-recommend-title">{{recommendPlanTitle}}</view>
          <view class="entitlements-recommend-meta">不限时会议、AI能力、无限云空间</view>
        </view>
        <view class="entitlements-recommend-action">
          <text>去选购</text>
          <image class="entitlements-arrow-icon" src="/assets/ui/arrow-light.svg" mode="aspectFit"></image>
        </view>
      </view>
    </view>
  </block>
</view>
