<view class="referral-page">
  <view class="referral-hero">
    <image class="referral-hero-icon" src="/assets/ui/referral-invite-icon.png" mode="aspectFit"></image>
    <view class="referral-hero-copy">
      <view class="referral-hero-title">邀请好友，送24小时权益卡</view>
      <view class="referral-hero-subtitle">好友激活讲了么账号后，你可以手动兑现 24 小时高级账号权益。</view>
    </view>
  </view>

  <view class="referral-section">
    <view class="referral-section-title">邀请记录</view>
    <view wx:if="{{loading}}" class="referral-empty">正在读取邀请记录</view>
    <view wx:elif="{{items.length === 0}}" class="referral-empty">还没有邀请记录</view>
    <view wx:else class="referral-list">
      <view wx:for="{{items}}" wx:key="inviteeUserId" class="referral-row">
        <image wx:if="{{item.inviteeAvatarUrl}}" class="referral-avatar" src="{{item.inviteeAvatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="referral-avatar fallback">{{item.initial}}</view>
        <view class="referral-row-main">
          <view class="referral-name">{{item.inviteeDisplayName}}</view>
          <view class="referral-status {{item.status}}">{{item.statusText}}</view>
        </view>
        <button
          wx:if="{{item.canRedeem}}"
          class="referral-redeem-button"
          data-id="{{item.inviteeUserId}}"
          loading="{{redeemingId === item.inviteeUserId}}"
          disabled="{{!!redeemingId}}"
          bindtap="redeemReward"
        >兑现</button>
      </view>
    </view>
  </view>

  <view class="referral-bottom-bar">
    <button class="primary-button referral-share-button" open-type="share">邀请好友</button>
  </view>
</view>
