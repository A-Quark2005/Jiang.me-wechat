.activation-page {
  min-height: 100vh;
  background: #ffffff;
  overflow: hidden;
  width: 100%;
}

.activation-top {
  position: relative;
  width: 100%;
  height: 682rpx;
  background: #0071fe;
  overflow: hidden;
}

.activation-logo-bg {
  position: absolute;
  left: -132rpx;
  top: -72rpx;
  width: 496rpx;
  height: 252rpx;
  opacity: 0.9;
}

.activation-mascot {
  position: absolute;
  left: 228rpx;
  top: 136rpx;
  width: 308rpx;
  height: 308rpx;
  z-index: 2;
}

.activation-brand-name {
  position: absolute;
  left: 298rpx;
  top: 506rpx;
  width: 156rpx;
  font-size: 48rpx;
  line-height: 72rpx;
  letter-spacing: 2rpx;
  color: #ffffff;
  z-index: 2;
}

.activation-brand-tagline {
  position: absolute;
  left: 280rpx;
  top: 596rpx;
  width: 192rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: rgba(255, 255, 255, 0.7);
  z-index: 2;
}

.activation-panel {
  position: relative;
  width: 100%;
  margin-top: -1rpx;
  min-height: calc(100vh - 682rpx);
  padding: 206rpx 32rpx 48rpx;
  background: #ffffff;
  border-radius: 56rpx 56rpx 0 0;
  box-sizing: border-box;
}

.activation-panel-copy {
  margin-bottom: 28rpx;
}

.activation-panel-copy-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.activation-panel-copy .section-title {
  font-size: 32rpx;
  line-height: 48rpx;
  color: #333333;
}

.activation-panel-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #999999;
}

.activation-main-button {
  width: 686rpx;
  height: 80rpx;
  padding: 0;
  margin: 0;
  background: #0071fe;
  border-radius: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 113, 254, 0.267);
  font-size: 32rpx;
  font-weight: 400;
  color: #ffffff;
}

.activation-login-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #8f96a3;
  text-align: center;
}

.activation-panel-copy-center .section-title,
.activation-panel-copy-center .activation-panel-subtitle {
  text-align: center;
}

.agreement-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  width: 654rpx;
  margin-top: 72rpx;
  margin-left: 16rpx;
}

.agreement-checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  margin-top: 2rpx;
  border: 2rpx solid #cccccc;
  border-radius: 8rpx;
  box-sizing: border-box;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 1;
  background: #ffffff;
}

.agreement-checkbox-on {
  background: #0071fe;
  border-color: #0071fe;
}

.agreement-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 38rpx;
  color: #999999;
}

.agreement-link {
  color: #0071fe;
}

.surface-card {
  padding: 0;
  background: transparent;
  box-shadow: none;
}

.surface-card .section-title {
  font-size: 32rpx;
  line-height: 48rpx;
  color: #333333;
}

.surface-card .section-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #999999;
}

.success-box,
.error-box {
  margin-top: 24rpx;
  font-size: 24rpx;
  line-height: 36rpx;
}

.success-box {
  color: #0071fe;
}

.error-box {
  color: #ff4d4f;
}
