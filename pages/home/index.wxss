.home-page {
  min-height: 100vh;
  padding: 0 0 24rpx;
  background: #0071fe;
}

.home-hero {
  position: relative;
  height: 654rpx;
  overflow: hidden;
}

.home-hero-art {
  position: absolute;
  inset: 0;
  overflow: visible;
  pointer-events: none;
}

.home-content-shell {
  position: relative;
  z-index: 1;
}

.home-hero-shell {
  position: absolute;
  inset: 0;
  padding: 0;
}

.home-body-shell {
  padding: 0 15px;
}

.hero-logo-bg {
  position: absolute;
  top: -72rpx;
  left: -132rpx;
  width: 496rpx;
  height: 252rpx;
}

.home-brand {
  min-height: 0;
}

.home-brand-copy {
  position: absolute;
  top: 202rpx;
  left: 42rpx;
  padding-top: 0;
}

.home-brand-name {
  font-size: 80rpx;
  line-height: 84rpx;
  font-weight: 400;
  letter-spacing: -1.26px;
  color: #ffffff;
}

.home-brand-tagline {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 40rpx;
  color: rgba(255, 255, 255, 0.75);
}

.home-mascot {
  position: absolute;
  top: 164rpx;
  left: 264rpx;
  width: 480rpx;
  height: 450rpx;
  z-index: 2;
}

.home-profile {
  position: absolute;
  top: 548rpx;
  left: 42rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 0;
}

.home-avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 999px;
  flex-shrink: 0;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.18);
}

.home-avatar-image {
  width: 68rpx;
  height: 68rpx;
}

.home-avatar-fallback {
  width: 68rpx;
  height: 68rpx;
  border-radius: 999px;
  text-align: center;
  font-size: 28rpx;
  line-height: 68rpx;
  color: #ffffff;
}

.home-profile-name {
  font-size: 28rpx;
  line-height: 34rpx;
  color: #ffffff;
}

.home-profile-copy {
  position: relative;
}

.home-profile-pending-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.home-profile-pending-text {
  font-size: 20rpx;
  line-height: 28rpx;
  color: rgba(255, 244, 199, 0.96);
}

.home-profile-pending-button {
  min-width: 128rpx;
  height: 48rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.36);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-size: 20rpx;
  line-height: 48rpx;
}

.home-profile-phone {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  letter-spacing: 0.22px;
  color: rgba(255, 255, 255, 0.65);
}

.home-entitlement-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 40rpx;
  min-height: 144rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 4px 4px rgba(0, 0, 0, 0.25);
}

.home-entitlement-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 96rpx;
  min-width: 0;
  flex: 1;
}

.home-entitlement-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  background: #eef5ff;
  flex-shrink: 0;
}

.home-entitlement-icon-image {
  width: 48rpx;
  height: 33.6rpx;
}

.home-entitlement-title {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #1a1a1a;
}

.home-entitlement-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  color: #b0b8c9;
}

.home-entitlement-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  line-height: 42rpx;
  color: #0071fe;
}

.home-arrow-icon {
  width: 31.96rpx;
  height: 31.96rpx;
}

.home-schedule-card {
  margin-top: 16rpx;
  padding: 48rpx 28rpx 36rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 4px 4px rgba(0, 0, 0, 0.25);
}

.home-field-label {
  font-size: 28rpx;
  line-height: 1.5;
  color: #000000;
}

.home-field-value {
  margin-top: 22rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #000000;
}

.meeting-subject-input {
  margin-top: 22rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #000000;
}

.home-field-placeholder {
  color: #bfbfbf;
}

.home-divider {
  height: 2rpx;
  margin: 16rpx 0 28rpx;
  background: #d9d9d9;
}

.home-time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}

.home-time-column {
  flex: 1;
}

.home-time-column.right {
  text-align: right;
}

.home-time-value {
  font-size: 56rpx;
  line-height: 1.5;
  color: #000000;
}

.home-date-value {
  margin-top: -4rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #000000;
}

.home-time-arrow-image {
  width: 13.76rpx;
  height: 27.18rpx;
  flex-shrink: 0;
}

.home-book-button {
  width: 100%;
  height: 80rpx;
  margin-top: 36rpx;
  font-size: 28rpx;
  border-radius: 8rpx;
}

.wechat-profile-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(0, 0, 0, 0.42);
}

.wechat-profile-modal {
  width: 100%;
  max-width: 640rpx;
  padding: 40rpx 32rpx 32rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.wechat-profile-title {
  font-size: 32rpx;
  line-height: 44rpx;
  color: #111827;
  text-align: center;
}

.wechat-profile-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #6b7280;
  text-align: center;
}

.wechat-profile-avatar-picker {
  position: relative;
  display: block;
  width: 152rpx;
  height: 152rpx;
  margin: 32rpx auto 0;
  padding: 6rpx;
  overflow: hidden;
  border: 2rpx solid #dbe8ff;
  border-radius: 50%;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(0, 113, 254, 0.14);
}

.wechat-profile-avatar-native-button {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  line-height: 1;
  opacity: 0;
}

.wechat-profile-avatar-native-button::after {
  border: 0;
}

.wechat-profile-avatar-image,
.wechat-profile-avatar-placeholder {
  display: block;
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
}

.wechat-profile-avatar-placeholder {
  background: #eef5ff;
  font-size: 28rpx;
  line-height: 136rpx;
  color: #0071fe;
  text-align: center;
}

.wechat-profile-nickname-input {
  height: 80rpx;
  margin-top: 28rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d9e2f2;
  border-radius: 8rpx;
  background: #f8fbff;
  font-size: 28rpx;
  line-height: 80rpx;
  color: #111827;
  box-sizing: border-box;
}

.wechat-profile-confirm {
  width: 100%;
  height: 80rpx;
  margin-top: 28rpx;
  border-radius: 8rpx;
  background: #0071fe;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 80rpx;
}

.home-reset-button {
  width: 100%;
  margin-top: 24rpx;
}

.home-reset-button-plain {
  border-color: rgba(255, 255, 255, 0.4);
  color: #ffffff;
  background: rgba(255, 255, 255, 0.08);
}

.home-reset-version {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.72);
}
