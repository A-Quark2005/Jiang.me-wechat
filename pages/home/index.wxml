<view class="page">
  <view class="hero">
    <view class="hero-title">账号服务中心</view>
    <view class="hero-subtitle">管理账号、可信资料和会议权益。安卓 APP 内的会议体验将继续使用腾讯会议原生能力。</view>
  </view>

  <view wx:if="{{loading}}" class="card">
    <view class="section-title">正在同步账号状态</view>
    <view class="section-subtitle">请稍候，正在读取你的资料和权益。</view>
  </view>

  <view wx:elif="{{errorMessage}}" class="card">
    <view class="section-title">加载失败</view>
    <view class="error-box">{{errorMessage}}</view>
    <button class="primary-button action-button" bindtap="refresh">重新加载</button>
    <button class="secondary-button action-button" bindtap="openRegister">重新注册登录</button>
  </view>

  <block wx:else>
    <view class="card">
      <view class="row">
        <view>
          <view class="section-title">{{profile.displayName || user.displayName || session.displayName || '已注册用户'}}</view>
          <view class="section-subtitle">{{phoneText}}</view>
        </view>
        <view class="pill status-ok">已注册</view>
      </view>
    </view>

    <view class="card tappable" bindtap="openEntitlements">
      <view class="row">
        <view>
          <view class="section-title">当前会议权益</view>
          <view class="section-subtitle">{{entitlementSummary.title}}</view>
          <view class="metric-line">{{entitlementSummary.detail}}</view>
        </view>
        <view class="pill {{entitlementSummary.tone === 'ok' ? 'status-ok' : 'status-warn'}}">{{entitlementSummary.tone === 'ok' ? '可用' : '去开通'}}</view>
      </view>
    </view>

    <view class="card tappable" bindtap="openResume">
      <view class="section-title">可信资料完整度</view>
      <view class="resume-grid">
        <view class="metric">
          <view class="metric-value">{{resumeSummary.completion}}%</view>
          <view class="metric-label">完成度</view>
        </view>
        <view class="metric">
          <view class="metric-value">{{resumeSummary.credentialCount}}</view>
          <view class="metric-label">官方认证</view>
        </view>
        <view class="metric">
          <view class="metric-value">{{resumeSummary.confirmedCount}}</view>
          <view class="metric-label">确认履历</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">待处理事项</view>
      <view class="task-row" bindtap="openEngagements">
        <view>待确认孪生履历</view>
        <view class="pill {{resumeSummary.pendingCount > 0 ? 'status-warn' : 'status-ok'}}">{{resumeSummary.pendingCount}}</view>
      </view>
      <view class="task-row" bindtap="openResume">
        <view>补充自我介绍</view>
        <view class="pill {{resumeSummary.needsSelfIntro ? 'status-warn' : 'status-ok'}}">{{resumeSummary.needsSelfIntro ? '待完善' : '已完成'}}</view>
      </view>
      <view class="task-row" bindtap="openOrders">
        <view>订单与权益记录</view>
        <view class="pill">查看</view>
      </view>
    </view>
  </block>
</view>
