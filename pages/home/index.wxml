<view class="page page-plain home-page">
  <view class="home-hero" style="padding-top: {{heroSafeTopPx}}px;">
    <view class="home-hero-art">
      <image class="hero-logo-bg" src="/assets/ui/tencent_meeting_logo_bg.svg" mode="aspectFit"></image>
      <image class="home-mascot" src="{{mascotUrl}}" mode="aspectFit"></image>
    </view>

    <view class="home-content-shell home-hero-shell">
      <view class="home-brand">
        <view class="home-brand-copy">
          <view class="home-brand-name">讲了么</view>
          <view class="home-brand-tagline">腾讯会议，官方授权</view>
        </view>
      </view>

      <view class="home-profile">
        <view class="home-avatar">
          <image wx:if="{{avatarUrl}}" class="home-avatar-image" src="{{avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="home-avatar-fallback">{{avatarText}}</view>
        </view>
        <view class="home-profile-copy">
          <view class="home-profile-name">{{displayNameText}}</view>
          <view wx:if="{{showPendingActivationNotice}}" class="home-profile-pending-row">
            <view class="home-profile-pending-text">{{pendingActivationText}}</view>
            <button class="home-profile-pending-button" loading="{{sendingActivationInvite}}" bindtap="resendActivationInvite">重发链接</button>
          </view>
          <view class="home-profile-phone">{{phoneText}}</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="surface-card">
    <view class="section-title">正在同步账号状态</view>
    <view class="section-subtitle">请稍候。</view>
  </view>

  <view wx:elif="{{errorMessage}}" class="surface-card">
    <view class="section-title">加载失败</view>
    <view class="error-box">{{errorMessage}}</view>
    <button class="primary-button action-button" bindtap="refresh">重新加载</button>
  </view>

  <block wx:else>
    <view class="home-content-shell home-body-shell">
      <view class="home-entitlement-card tappable" bindtap="openEntitlements">
        <view class="home-entitlement-main">
          <view class="home-entitlement-icon">
            <image class="home-entitlement-icon-image" src="/assets/ui/entitlement-card-icon.svg" mode="aspectFit"></image>
          </view>
          <view class="row-main">
            <view class="home-entitlement-title">{{entitlementSummary.title}}</view>
            <view class="home-entitlement-meta">{{entitlementSummary.detail}}</view>
          </view>
        </view>
        <view class="home-entitlement-action">
          <text>{{entitlementActionText}}</text>
          <image class="home-arrow-icon" src="/assets/ui/arrow-primary.svg" mode="aspectFit"></image>
        </view>
      </view>

      <view class="home-schedule-card">
        <view class="home-field">
          <view class="home-field-label">会议主题</view>
          <input
            class="meeting-subject-input"
            value="{{subject}}"
            bindinput="onSubjectInput"
            placeholder="请输入会议主题"
            maxlength="50"
          />
        </view>

        <view class="home-divider"></view>

        <view class="home-field">
          <view class="home-field-label">会议时间</view>
          <view class="home-time-row">
            <view class="home-time-column">
              <picker mode="time" value="{{startTime}}" bindchange="onStartTimeChange">
                <view class="home-time-value">{{startTime}}</view>
              </picker>
              <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
                <view class="home-date-value">{{startDateLabel}}</view>
              </picker>
            </view>
            <image class="home-time-arrow-image" src="/assets/ui/time-arrow.svg" mode="aspectFit"></image>
            <view class="home-time-column right">
              <picker mode="time" value="{{endTime}}" bindchange="onEndTimeChange">
                <view class="home-time-value">{{endTime}}</view>
              </picker>
              <picker mode="date" value="{{endDate}}" bindchange="onEndDateChange">
                <view class="home-date-value">{{endDateLabel}}</view>
              </picker>
            </view>
          </view>
        </view>

        <view wx:if="{{errorMessage}}" class="error-box">{{errorMessage}}</view>

        <button
          class="primary-button home-book-button"
          bindtap="submit"
          loading="{{submitting}}"
          disabled="{{submitting}}"
        >
          {{submitButtonText}}
        </button>
      </view>

    </view>

  <view wx:if="{{showWechatProfileModal}}" class="wechat-profile-modal-mask" catchtouchmove="noop">
    <view class="wechat-profile-modal">
      <view class="wechat-profile-title">完善头像昵称</view>
      <view class="wechat-profile-subtitle">用于展示你的讲了么账号资料，不影响手机号绑定。</view>
      <button class="wechat-profile-avatar-button" open-type="chooseAvatar" bindchooseavatar="onProfileModalChooseAvatar">
        <image wx:if="{{profileDraftAvatarUrl}}" class="wechat-profile-avatar-image" src="{{profileDraftAvatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="wechat-profile-avatar-placeholder">头像</view>
      </button>
      <input
        class="wechat-profile-nickname-input"
        type="nickname"
        value="{{profileDraftNickname}}"
        bindinput="onProfileModalNicknameInput"
        placeholder="请输入昵称"
        maxlength="64"
      />
      <button class="wechat-profile-confirm" bindtap="confirmWechatProfile" loading="{{savingWechatProfile}}">确认</button>
    </view>
  </view>
  </block>
</view>
