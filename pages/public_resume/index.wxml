<view class="page page-plain public-resume-page">
  <view wx:if="{{loading}}" class="surface-card">
    <view class="section-title">正在读取资料</view>
  </view>

  <view wx:elif="{{errorMessage}}" class="surface-card">
    <view class="section-title">读取失败</view>
    <view class="error-box">{{errorMessage}}</view>
    <button class="primary-button action-button" bindtap="loadResume">重新加载</button>
  </view>

  <block wx:else>
    <view class="surface-card public-profile-card">
      <view class="public-profile-main">
        <image class="public-avatar" src="{{resume.avatarUrlResolved}}" mode="aspectFill" data-url="{{resume.avatarUrlResolved}}" bindtap="previewAvatar"></image>
        <view class="public-profile-copy">
          <view class="public-name">{{resume.displayName}}</view>
          <view class="public-tier">{{resume.accountTierText}}</view>
        </view>
      </view>
      <view class="public-share-button">
        <image class="public-share-icon" src="/assets/ui/share-outline-black.svg" mode="aspectFit"></image>
        <view class="public-share-hint">转发页面</view>
        <button class="public-share-native" aria-label="share" bindtap="showShareOptions"></button>
      </view>
    </view>
    <view class="surface-card public-section">
      <view class="section-title">认证</view>
      <view wx:if="{{credentials.length === 0}}" class="public-empty">暂无认证</view>
      <view wx:for="{{credentials}}" wx:key="id" class="public-credential {{item.canOpenMembers ? 'tappable' : ''}}" data-id="{{item.organizationId}}" bindtap="openOrganizationMembers">
        <image wx:if="{{item.logoUrl}}" class="public-credential-logo" src="{{item.logoUrl}}" mode="aspectFit"></image>
        <view class="row-main">
          <view class="public-credential-title">{{item.title}}</view>
          <view class="public-credential-meta">{{item.emailMasked}}</view>
        </view>
      </view>
    </view>

    <view class="surface-card public-section">
      <view class="public-section-head">
        <view class="section-title">自我介绍</view>
        <view class="consulting-fee-badge">{{consultingFeeText}}</view>
      </view>
      <text selectable="{{true}}" class="public-text">{{selfIntroductionText}}</text>
    </view>

    <view class="surface-card public-section">
      <view class="section-title">服务履历</view>
      <view wx:if="{{serviceEngagements.length === 0}}" class="public-empty">暂无公开履历</view>
      <view wx:for="{{serviceEngagements}}" wx:key="id" class="public-engagement">
        <view class="public-engagement-title">{{item.displayNumber}}. {{item.title}}</view>
        <view wx:if="{{item.metaText}}" class="public-engagement-meta">{{item.metaText}}</view>
        <text wx:for="{{item.detailLines}}" wx:for-item="line" wx:key="*this" selectable="{{true}}" class="public-engagement-summary">{{line}}</text>
      </view>
    </view>

    <view class="surface-card public-section">
      <view class="section-title">消费履历</view>
      <view wx:if="{{consumptionEngagements.length === 0}}" class="public-empty">暂无公开履历</view>
      <view wx:for="{{consumptionEngagements}}" wx:key="id" class="public-engagement">
        <view class="public-engagement-title">{{item.displayNumber}}. {{item.title}}</view>
        <view wx:if="{{item.metaText}}" class="public-engagement-meta">{{item.metaText}}</view>
        <text wx:for="{{item.detailLines}}" wx:for-item="line" wx:key="*this" selectable="{{true}}" class="public-engagement-summary">{{line}}</text>
      </view>
    </view>
    <view class="contact-action-bar">
      <button class="primary-button contact-action-button" loading="{{contactActionLoading}}" disabled="{{contactActionLoading}}" bindtap="handleContactDeposit">{{contactButtonText}}</button>
    </view>
  </block>
</view>

<view wx:if="{{sharePanelVisible}}" class="wechat-share-mask" catchtap="hideShareOptions">
  <view class="wechat-share-sheet" catchtap="noop">
    <button class="wechat-share-item" open-type="share">{{shareMenuText.friend}}</button>
    <view class="wechat-share-line"></view>
    <button class="wechat-share-item" loading="{{miniProgramCodeLoading}}" disabled="{{miniProgramCodeLoading}}" bindtap="handleMiniProgramCode">{{shareMenuText.code}}</button>
    <view class="wechat-share-gap"></view>
    <button class="wechat-share-cancel" bindtap="hideShareOptions">{{shareMenuText.cancel}}</button>
  </view>
</view>
<canvas canvas-id="publicResumeShareCanvas" class="share-canvas" style="width: 500px; height: 400px;"></canvas>
