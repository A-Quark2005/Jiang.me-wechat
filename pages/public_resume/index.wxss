.public-resume-page {
  min-height: 100vh;
  padding: 18rpx 16px 32rpx;
  box-sizing: border-box;
}

.public-profile-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 150rpx;
  padding-right: 112rpx;
}

.public-profile-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-width: 0;
  flex: 1;
}

.public-profile-copy {
  min-width: 0;
  flex: 1;
}

.public-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.public-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #152033;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.public-tier {
  margin-top: 6rpx;
  color: #7d8799;
  font-size: 26rpx;
  line-height: 36rpx;
}

.public-share-button {
  position: absolute;
  right: 28rpx;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #111111;
  line-height: 1;
  flex-shrink: 0;
  transform: translateY(-50%);
}

.public-share-native {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  opacity: 0;
}

.public-share-native::after {
  border: 0;
}

.public-share-icon {
  display: block;
  width: 44rpx;
  height: 44rpx;
}

.public-share-hint {
  position: absolute;
  left: 50%;
  top: 62rpx;
  transform: translateX(-50%);
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 30rpx;
  white-space: nowrap;
}

.public-section {
  margin-top: 16rpx;
}

.public-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.consulting-fee-badge {
  flex-shrink: 0;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.public-text,
.public-empty {
  margin-top: 16rpx;
  color: #8b95a5;
  font-size: 26rpx;
  line-height: 42rpx;
}

.public-text {
  white-space: pre-wrap;
}

.public-empty {
  text-align: center;
}

.public-credential,
.public-engagement {
  padding: 18rpx 0;
  border-top: 1rpx solid #f0f2f5;
}

.public-credential {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.public-credential:first-of-type,
.public-engagement:first-of-type {
  border-top: 0;
}

.public-credential-logo {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.public-credential-title,
.public-engagement-title {
  color: #152033;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.public-credential-meta,
.public-engagement-meta,
.public-engagement-summary {
  margin-top: 4rpx;
  color: #9ca3af;
  font-size: 24rpx;
  line-height: 36rpx;
}

.public-engagement-summary {
  color: #6b7280;
}

.contact-action-bar {
  margin: 32rpx -16px 0;
  padding: 16rpx 16px calc(20rpx + env(safe-area-inset-bottom));
  background: #f7f8fa;
  box-sizing: border-box;
}

.contact-action-button {
  display: flex;
  width: 100% !important;
  max-width: none;
  height: 92rpx;
  margin-left: 0;
  margin-right: 0;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.share-canvas {
  position: fixed;
  left: -10000px;
  top: -10000px;
  opacity: 0;
  pointer-events: none;
}

.wechat-share-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.58);
}

.wechat-share-sheet {
  width: 100%;
  overflow: hidden;
  border-radius: 28rpx 28rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: #ffffff;
}

.wechat-share-item,
.wechat-share-cancel {
  display: flex;
  width: 100% !important;
  min-width: 0;
  max-width: none;
  height: 118rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  background: #ffffff;
  color: #111111;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 118rpx;
  text-align: center;
}

.wechat-share-item::after,
.wechat-share-cancel::after {
  border: 0;
}

.wechat-share-line {
  width: 100%;
  height: 1rpx;
  margin: 0;
  padding: 0;
  background: #e5e5e5;
  transform: scaleY(0.5);
  transform-origin: 0 0;
}

.wechat-share-gap {
  width: 100%;
  height: 18rpx;
  background: #f2f2f2;
}

.wechat-share-cancel {
  color: #333333;
}
