<view class="page page-with-bar engagement-detail-page">
  <view wx:if="{{loading}}" class="surface-card">正在读取履历详情</view>

  <view wx:elif="{{errorMessage && !item}}" class="surface-card">
    <view class="error-box">{{errorMessage}}</view>
    <button class="primary-button action-button" bindtap="loadDetail">重新加载</button>
  </view>

  <block wx:else>
    <view class="surface-card detail-fact-card">
      <view class="detail-head-row">
        <view class="detail-title">{{detailTitleText}}</view>
        <view class="pill {{detailStatusClass}}">{{detailStatusText}}</view>
      </view>

      <view class="detail-line-row">
        <view class="detail-label">类型</view>
        <view class="detail-value">{{typeLabelText}}</view>
      </view>
      <view class="detail-line-row">
        <view class="detail-label">对方</view>
        <view class="detail-value">{{counterpartNameText}}</view>
      </view>
      <view class="detail-line-row">
        <view class="detail-label">开始时间</view>
        <view class="detail-value">{{startedAtDisplayText}}</view>
      </view>
    </view>

    <view class="surface-card detail-content-card">
      <view class="section-title">服务内容</view>
      <view class="detail-content-text">{{detailText}}</view>
    </view>

    <view class="soft-note detail-note">孪生履历需双方同意方可修改或删除 系统将自动通知对方</view>

    <view wx:if="{{editing}}" class="surface-card">
      <view class="section-title">修改履历</view>
      <view class="field">
        <view class="field-label">标题</view>
        <input class="input" value="{{editForm.title}}" data-field="title" bindinput="updateEditField" maxlength="64" placeholder="请输入标题" />
      </view>
      <view class="field">
        <view class="field-label">详情</view>
        <textarea class="textarea" value="{{editForm.detailText}}" data-field="detailText" bindinput="updateEditField" maxlength="1200" placeholder="可分行填写详情" />
      </view>
      <view class="row action-row">
        <button class="ghost-button row-flex-button" bindtap="cancelEdit" disabled="{{submitting}}">取消</button>
        <button class="primary-button row-flex-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitEdit">提交修改申请</button>
      </view>
    </view>

    <view wx:if="{{errorMessage}}" class="error-box">{{errorMessage}}</view>

    <view wx:if="{{needsMyConfirmation}}" class="bottom-bar button-row safe-bottom-pad">
      <button wx:if="{{!inviteMode}}" class="danger-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="reject">拒绝</button>
      <button class="primary-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="confirm">确认</button>
    </view>

    <view wx:elif="{{waitingForOtherConfirmation}}" class="bottom-bar safe-bottom-pad">
      <button class="primary-button full-button" open-type="share" bindtap="shareConfirmation">发给微信联系人确认</button>
    </view>

    <view wx:else class="bottom-bar button-row safe-bottom-pad">
      <button class="outline-button row-flex-button detail-bottom-button" bindtap="startEdit" disabled="{{bottomActionDisabled}}">申请修改</button>
      <button class="danger-button row-flex-button detail-bottom-button" bindtap="requestDelete" disabled="{{bottomActionDisabled}}">申请删除</button>
    </view>
  </block>
</view>
