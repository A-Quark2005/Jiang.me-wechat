.engagement-detail-page {
  padding-top: 18rpx;
}

.detail-fact-card {
  margin-top: 16rpx;
  padding-top: 28rpx;
  padding-bottom: 18rpx;
}

.detail-head-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.detail-title {
  min-width: 0;
  flex: 1;
  font-size: 36rpx;
  line-height: 1.38;
  font-weight: 500;
  color: #333333;
}

.detail-line-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-head-row + .detail-line-row {
  margin-top: 18rpx;
}

.detail-line-row:last-child {
  border-bottom: 0;
  padding-bottom: 6rpx;
}

.detail-label {
  width: 116rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  line-height: 1.5;
  color: #b0b8c9;
}

.detail-value {
  min-width: 0;
  flex: 1;
  font-size: 28rpx;
  line-height: 1.5;
  color: #333333;
}

.detail-content-card {
  margin-top: 16rpx;
  min-height: 238rpx;
}

.detail-content-text {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #b0b8c9;
  white-space: pre-wrap;
}

.detail-note {
  margin-top: 22rpx;
  margin-bottom: 120rpx;
}

.action-row {
  gap: 18rpx;
}

.row-flex-button,
.full-button {
  width: 100%;
}

.button-row .row-flex-button,
.button-row > button {
  min-width: 0;
  width: auto;
}

.detail-bottom-button {
  height: 96rpx;
}
