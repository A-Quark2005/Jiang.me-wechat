.edit-self-page {
  padding-top: 18rpx;
}

.edit-self-card {
  margin-top: 16rpx;
}

.edit-self-field {
  margin-top: 0;
}

.edit-self-textarea {
  min-height: 320rpx;
  padding: 22rpx 0 0;
  background: transparent;
}

.edit-self-switch-row {
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
}

.consult-fee-field {
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
}

.consult-fee-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 88rpx;
}

.consult-fee-control {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  justify-content: flex-end;
  box-sizing: border-box;
}

.consult-fee-input {
  width: 180rpx;
  height: 72rpx;
  padding: 0 12rpx;
  color: #152033;
  font-size: 30rpx;
  text-align: right;
  background: #f7f9fc;
  border: 1rpx solid #e4e9f2;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.consult-fee-unit {
  flex-shrink: 0;
  margin-left: 12rpx;
  color: #687386;
  font-size: 28rpx;
}

.consult-fee-desc {
  margin-top: 14rpx;
  line-height: 38rpx;
}

.bottom-bar button {
  width: 100%;
  height: 96rpx;
}
