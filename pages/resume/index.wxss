.resume-page {
  padding-top: 18rpx;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
}

.profile-stack {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding-top: 36rpx;
}

.resume-pending-card {
  margin-bottom: 0;
}

.resume-pending-button {
  margin-top: 20rpx;
}

.intro-card {
  min-height: 180rpx;
}

.soft-empty {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #b0b8c9;
}

.feature-card {
  min-height: 176rpx;
}

.feature-icon {
  background: #f0f5ff;
}

.feature-icon-image {
  width: 22px;
  height: 22px;
}

.page-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 8rpx;
  color: #0071fe;
  font-size: 28rpx;
  line-height: 1.5;
  white-space: nowrap;
}

.page-link-with-icon {
  gap: 3.99px;
}

.page-link-icon {
  width: 15.98px;
  height: 15.98px;
}

.public-home-button {
  width: 100%;
  height: 96rpx;
  margin-top: 8rpx;
}
