<view class="page page-with-bar page-plain engagement-create-page">
  <view class="engagement-create-tabs">
    <radio-group class="segmented-strip engagement-create-strip" bindchange="changeKind">
      <label class="engagement-create-chip tappable {{kindProvidedClass}}">
        <radio value="provided" checked="{{kindProvidedChecked}}" />
        我服务过
      </label>
      <label class="engagement-create-chip tappable {{kindReceivedClass}}">
        <radio value="received" checked="{{kindReceivedChecked}}" />
        我被服务过
      </label>
    </radio-group>
  </view>

  <view class="surface-card engagement-create-card">
    <view class="engagement-create-tip-section">
      <view class="section-title">{{helperTitleText}}</view>
      <view class="section-subtitle">{{helperBodyText}}</view>
      <view wx:if="{{invite}}" class="success-box engagement-create-success">{{inviteReadyText}}</view>
      <view wx:if="{{errorMessage}}" class="error-box">{{errorMessage}}</view>
      <view wx:if="{{invite}}" class="engagement-create-invite-actions">
        <button class="primary-button action-button" open-type="share" bindtap="openShare">发给微信联系人</button>
        <button class="outline-button action-button" bindtap="openDetail">查看履历</button>
      </view>
    </view>

    <view class="engagement-create-form-section">
      <view class="field">
        <view class="field-label">履历标题</view>
        <input
          class="input engagement-create-input"
          value="{{form.title}}"
          data-field="title"
          bindinput="updateField"
          placeholder="例如：AI产品设计咨询"
          maxlength="40"
        />
      </view>

      <view class="field">
        <view class="field-label">服务内容</view>
        <textarea
          class="textarea engagement-create-textarea"
          value="{{form.detailText}}"
          data-field="detailText"
          bindinput="updateField"
          placeholder="可分行填写服务时间、内容、结果与备注"
          maxlength="300"
        />
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="primary-button full-button" loading="{{saving}}" disabled="{{saveButtonDisabled}}" bindtap="save">
      {{submitLabelText}}
    </button>
  </view>
</view>
