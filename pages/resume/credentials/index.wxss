.credentials-page {
  padding-top: 18rpx;
}

.credentials-state-card {
  margin-top: 18rpx;
}

.credentials-section {
  margin-top: 22rpx;
}

.credentials-section:first-child {
  margin-top: 12rpx;
}

.credentials-section-title {
  padding: 0 4rpx 14rpx;
  color: #152033;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}

.credentials-list,
.organization-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.credentials-card,
.organization-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 132rpx;
  padding: 24rpx 26rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 24rpx rgba(21, 32, 51, 0.06);
}

.cert-logo-frame,
.credentials-badge,
.organization-logo-fallback {
  width: 84rpx;
  height: 84rpx;
  flex-shrink: 0;
}

.cert-logo-frame {
  border-radius: 12rpx;
  background: #ffffff;
}

.cert-logo-image {
  display: block;
  width: 100%;
  height: 100%;
}

.credentials-badge,
.organization-logo-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #eef5ff;
  color: #0071fe;
  font-size: 30rpx;
  font-weight: 700;
}

.credentials-main,
.organization-main {
  min-width: 0;
  flex: 1;
}

.credentials-title,
.organization-title {
  overflow: hidden;
  color: #152033;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.42;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.credentials-meta,
.organization-description,
.organization-domains {
  margin-top: 6rpx;
  color: #8a94a6;
  font-size: 24rpx;
  line-height: 1.45;
}

.credentials-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
}

.credentials-status,
.organization-certified {
  flex-shrink: 0;
  min-height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #eef5ff;
  color: #0071fe;
  font-size: 23rpx;
  line-height: 48rpx;
}

.organization-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.organization-action {
  flex-shrink: 0;
  color: #0071fe;
  font-size: 26rpx;
  line-height: 1.5;
}

.credentials-empty {
  padding: 34rpx 30rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 24rpx rgba(21, 32, 51, 0.06);
}

.credentials-empty-title {
  color: #152033;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
}

.credentials-empty-subtitle {
  margin-top: 8rpx;
  color: #8a94a6;
  font-size: 24rpx;
  line-height: 1.55;
}

.credential-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  background: rgba(0, 0, 0, 0.42);
}

.credential-modal {
  width: 100%;
  max-width: 640rpx;
  box-sizing: border-box;
  padding: 34rpx 32rpx 30rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 80rpx rgba(21, 32, 51, 0.22);
}

.credential-modal-title {
  color: #152033;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
}

.credential-modal-subtitle,
.credential-domain-note,
.credential-sent-note {
  margin-top: 10rpx;
  color: #8a94a6;
  font-size: 24rpx;
  line-height: 1.55;
  text-align: center;
}

.credential-domain-note {
  color: #0071fe;
}

.credential-field {
  margin-top: 28rpx;
}

.credential-label {
  margin-bottom: 12rpx;
  color: #333333;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
}

.credential-input {
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d9e2f2;
  border-radius: 8rpx;
  background: #f8fbff;
  color: #152033;
  font-size: 28rpx;
  line-height: 84rpx;
}

.credential-modal-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 30rpx;
}

.credential-code-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.credential-code-input {
  flex: 1;
  min-width: 0;
}

.credential-send-button {
  flex-shrink: 0;
  width: 188rpx;
  height: 84rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.credential-modal-button {
  flex: 1;
  min-width: 0;
  max-width: none;
  height: 84rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border-radius: 8rpx;
}
