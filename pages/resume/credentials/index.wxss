.credentials-page {
  padding-top: 18rpx;
}

.credentials-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}

.credentials-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 128rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.credentials-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.credentials-badge-red {
  background: #fff1f0;
  color: #b5191a;
}

.credentials-badge-green {
  background: #eff8ef;
  color: #145c2c;
}

.credentials-title {
  min-width: 0;
  flex: 1;
  font-size: 32rpx;
  line-height: 1.5;
  color: #333333;
}

.credentials-arrow {
  font-size: 30rpx;
}

.credentials-note {
  margin-top: 24rpx;
}
