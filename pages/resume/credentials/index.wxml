<view class="page">
  <view class="hero">
    <view class="hero-title">官方认证</view>
    <view class="hero-subtitle">认证由官方渠道签发，用于提升可信资料的可信度。</view>
  </view>

  <view wx:if="{{loading}}" class="card">正在读取官方认证</view>
  <view wx:elif="{{errorMessage}}" class="card">
    <view class="error-box">{{errorMessage}}</view>
    <button class="primary-button action-button" bindtap="loadCredentials">重新加载</button>
  </view>
  <view wx:elif="{{credentials.length === 0}}" class="empty-box">暂无官方认证</view>

  <view wx:for="{{credentials}}" wx:key="id" class="card">
    <view class="row">
      <view>
        <view class="section-title">{{item.title || item.name || '官方认证'}}</view>
        <view class="section-subtitle">{{item.summary || item.description || '由官方渠道签发'}}</view>
      </view>
      <view class="pill">{{item.status || '未知'}}</view>
    </view>
    <view class="detail-line">签发方：{{item.issuerName || item.issuerPublicAccountId || '官方渠道'}}</view>
    <view class="detail-line">签发时间：{{item.issuedAt || item.createdAt || '暂无'}}</view>
    <view class="detail-line">有效期：{{item.expiresAt || '长期有效'}}</view>
  </view>
</view>
