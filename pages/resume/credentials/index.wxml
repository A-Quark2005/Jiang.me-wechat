<view class="page credentials-page">
  <view wx:if="{{loading}}" class="surface-card credentials-state-card">正在读取我的认证</view>
  <view wx:elif="{{errorMessage}}" class="surface-card credentials-state-card">
    <view class="error-box">{{errorMessage}}</view>
    <button class="primary-button action-button" bindtap="refresh">重新加载</button>
  </view>

  <block wx:else>
    <view class="credentials-section">
      <view class="credentials-section-title">已认证</view>
      <view wx:if="{{credentials.length === 0}}" class="credentials-empty">
        <view class="credentials-empty-title">暂无我的认证</view>
        <view class="credentials-empty-subtitle">选择下方组织，使用对应邮箱完成认证。</view>
      </view>
      <view wx:else class="credentials-list">
        <view wx:for="{{credentials}}" wx:key="id" class="credentials-card">
          <view class="cert-logo-frame {{item.logoFrameClass}}">
            <image wx:if="{{item.logoUrl}}" class="cert-logo-image" src="{{item.logoUrl}}" mode="aspectFit"></image>
            <view wx:else class="credentials-badge">{{item.badgeText}}</view>
          </view>
          <view class="credentials-main">
            <view class="credentials-title">{{item.titleText}}</view>
            <view class="credentials-meta">
              <text wx:if="{{item.emailMaskedText}}">{{item.emailMaskedText}}</text>
              <text wx:if="{{item.verifiedAtText}}">认证于 {{item.verifiedAtText}}</text>
            </view>
          </view>
          <view class="credentials-status">已认证</view>
        </view>
      </view>
    </view>

    <view class="credentials-section">
      <view class="credentials-section-title">可认证组织</view>
      <view wx:if="{{organizations.length === 0}}" class="credentials-empty">
        <view class="credentials-empty-title">暂无可认证组织</view>
        <view class="credentials-empty-subtitle">后续开放新的第三方组织后会显示在这里。</view>
      </view>
      <view wx:else class="organization-list">
        <view wx:for="{{organizations}}" wx:key="id" class="organization-card tappable" data-id="{{item.id}}" bindtap="openOrganization">
          <view class="cert-logo-frame {{item.logoFrameClass}}">
            <image wx:if="{{item.logoUrl}}" class="cert-logo-image" src="{{item.logoUrl}}" mode="aspectFit"></image>
            <view wx:else class="organization-logo-fallback">{{item.logoFallbackText}}</view>
          </view>
          <view class="organization-main">
            <view class="organization-title-row">
              <view class="organization-title">{{item.nameText}}</view>
              <view wx:if="{{item.certified}}" class="organization-certified">已认证</view>
            </view>
            <view class="organization-description">{{item.descriptionText}}</view>
            <view wx:if="{{item.domainText}}" class="organization-domains">{{item.domainText}}</view>
          </view>
          <view wx:if="{{!item.certified}}" class="organization-action">认证</view>
        </view>
      </view>
    </view>

    <view wx:if="{{showVerifyModal}}" class="credential-modal-mask" catchtouchmove="noop" bindtap="closeVerifyModal">
      <view class="credential-modal" catchtap="noop">
        <view class="credential-modal-title">{{activeOrganization.nameText}}</view>
        <view class="credential-modal-subtitle">请输入属于该组织的邮箱，并使用验证码完成认证。</view>
        <view wx:if="{{activeOrganization.domainText}}" class="credential-domain-note">{{activeOrganization.domainText}}</view>

        <view class="credential-field">
          <view class="credential-label">组织邮箱</view>
          <input
            class="credential-input"
            value="{{emailInput}}"
            bindinput="onEmailInput"
            placeholder="请输入邮箱"
            type="text"
            maxlength="190"
          />
        </view>

        <view wx:if="{{emailMaskedText}}" class="credential-sent-note">验证码已发送至 {{emailMaskedText}}</view>

        <view class="credential-field">
          <view class="credential-label">验证码</view>
          <view class="credential-code-row">
            <input
              class="credential-input credential-code-input"
              value="{{codeInput}}"
              bindinput="onCodeInput"
              placeholder="6 位数字验证码"
              type="number"
              maxlength="6"
            />
            <button
              class="ghost-button credential-send-button"
              loading="{{sendingCode}}"
              disabled="{{!canSendCode || sendingCode}}"
              bindtap="sendCode"
            >
              发送验证码
            </button>
          </view>
        </view>

        <view class="credential-modal-actions">
          <button class="secondary-button credential-modal-button" bindtap="closeVerifyModal" disabled="{{sendingCode || verifying}}">取消</button>
          <button class="primary-button credential-modal-button" loading="{{verifying}}" disabled="{{verifying}}" bindtap="verifyCode">完成认证</button>
        </view>
      </view>
    </view>
  </block>
</view>
