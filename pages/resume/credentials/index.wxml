<view class="page credentials-page">
  <view wx:if="{{loading}}" class="surface-card">正在读取官方认证</view>
  <view wx:elif="{{errorMessage}}" class="surface-card">
    <view class="error-box">{{errorMessage}}</view>
    <button class="primary-button action-button" bindtap="loadCredentials">重新加载</button>
  </view>
  <view wx:elif="{{credentials.length === 0}}" class="empty-box">暂无官方认证</view>

  <view wx:else class="credentials-list">
    <view wx:for="{{credentials}}" wx:key="id" class="credentials-card">
      <view class="credentials-badge {{item.badgeClass}}">{{item.badgeText}}</view>
      <view class="credentials-title">{{item.titleText}}</view>
      <view class="arrow-light credentials-arrow">›</view>
    </view>
  </view>

  <view class="soft-note credentials-note">认证由官方签发，仅支持本校师生 如有问题请联系客服</view>
</view>
