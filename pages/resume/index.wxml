<view class="page">
  <view class="hero">
    <view class="hero-title">可信资料</view>
    <view class="hero-subtitle">维护自我介绍、官方认证和双方确认的服务履历。</view>
  </view>

  <view wx:if="{{loading}}" class="card">
    <view class="section-title">正在读取资料</view>
  </view>

  <view wx:elif="{{errorMessage}}" class="card">
    <view class="section-title">读取失败</view>
    <view class="error-box">{{errorMessage}}</view>
    <button class="primary-button action-button" bindtap="loadResume">重新加载</button>
  </view>

  <block wx:else>
    <view class="card">
      <view class="row">
        <view>
          <view class="section-title">官方认证</view>
          <view class="section-subtitle">由官方渠道签发，用于提升资料可信度。</view>
        </view>
        <button class="ghost-button mini-button" bindtap="openCredentials">查看</button>
      </view>
      <view wx:if="{{credentials.length === 0}}" class="empty-box">暂无官方认证</view>
      <view wx:for="{{credentials}}" wx:key="id" class="list-row">
        <view>
          <view class="row-title">{{item.title || item.name || '官方认证'}}</view>
          <view class="muted small">{{item.issuerName || item.issuerPublicAccountId || '官方渠道'}}</view>
        </view>
        <view class="pill">{{item.status || '未知'}}</view>
      </view>
    </view>

    <view class="card">
      <view class="row">
        <view>
          <view class="section-title">自我介绍</view>
          <view class="section-subtitle">{{resume.selfIntroduction || '补充自我介绍，让对方更快了解你的服务背景。'}}</view>
        </view>
        <button class="ghost-button mini-button" bindtap="openEditSelf">编辑</button>
      </view>
    </view>

    <view class="card">
      <view class="row">
        <view>
          <view class="section-title">服务履历</view>
          <view class="section-subtitle">已确认的履历会展示在你的可信资料中。</view>
        </view>
        <button class="ghost-button mini-button" bindtap="createEngagement">新建</button>
      </view>
      <view class="resume-grid">
        <view class="metric" bindtap="openEngagements" data-tab="provided">
          <view class="metric-value">{{engagementGroups.provided.length}}</view>
          <view class="metric-label">我服务过</view>
        </view>
        <view class="metric" bindtap="openEngagements" data-tab="received">
          <view class="metric-value">{{engagementGroups.received.length}}</view>
          <view class="metric-label">我被服务过</view>
        </view>
        <view class="metric" bindtap="openEngagements" data-tab="pending">
          <view class="metric-value">{{engagementGroups.pending.length}}</view>
          <view class="metric-label">待确认</view>
        </view>
      </view>
    </view>
  </block>
</view>
