<view class="page page-with-bar page-plain resume-page">
  <view wx:if="{{loading}}" class="surface-card">
    <view class="section-title">正在读取资料</view>
  </view>

  <view wx:elif="{{errorMessage}}" class="surface-card">
    <view class="section-title">读取失败</view>
    <view class="error-box">{{errorMessage}}</view>
    <button class="primary-button action-button" bindtap="loadResume">重新加载</button>
  </view>

  <block wx:else>
    <view class="profile-stack">
      <view class="surface-card account-card">
        <view class="account-avatar tappable" bindtap="openWechatProfileEditor">
          <image wx:if="{{avatarUrl}}" class="account-avatar-image" src="{{avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="account-avatar-fallback">{{avatarText}}</view>
        </view>
        <view class="account-copy">
          <view class="account-name tappable" bindtap="openWechatProfileEditor">{{displayNameText}}</view>
          <view class="account-tier {{accountTierClass}}">{{accountTierText}}</view>
        </view>
      </view>

      <view class="surface-card intro-card tappable" bindtap="openEditSelf">
        <view class="row">
          <view class="section-title">自我介绍</view>
          <view class="page-link tap-target-inline">编辑</view>
        </view>
        <view class="soft-empty">{{selfIntroductionText}}</view>
      </view>

      <view class="surface-card feature-card tappable" bindtap="openCredentials">
        <view class="row">
          <view class="row feature-row">
            <view class="feature-icon">
              <image class="feature-icon-image" src="/assets/ui/credentials-icon.svg" mode="aspectFit"></image>
            </view>
            <view class="row-main">
              <view class="row-title">我的认证</view>
              <view class="row-meta">第三方认证，提升资料完整度</view>
            </view>
          </view>
          <view class="page-link page-link-with-icon tap-target-inline">
            <text>查看</text>
            <image class="page-link-icon" src="/assets/ui/arrow-light.svg" mode="aspectFit"></image>
          </view>
        </view>
      </view>

      <view class="surface-card feature-card">
        <view class="row">
          <view class="row feature-row">
            <image class="feature-icon-image-engagement" src="/assets/ui/engagement-profile.png" mode="aspectFit"></image>
            <view class="row-main">
              <view class="row-title">服务履历</view>
              <view class="row-meta">已确认的履历会展示在你的资料中</view>
            </view>
          </view>
          <view class="page-link page-link-with-icon tap-target-inline" bindtap="createEngagement">
            <text>新建</text>
            <image class="page-link-icon" src="/assets/ui/arrow-light.svg" mode="aspectFit"></image>
          </view>
        </view>
        <view class="stats-grid">
          <view class="stat-box tappable" bindtap="openEngagements" data-tab="provided">
            <view class="stat-value">{{engagementGroups.provided.length}}</view>
            <view class="stat-label">我服务过</view>
          </view>
          <view class="stat-box tappable" bindtap="openEngagements" data-tab="received">
            <view class="stat-value">{{engagementGroups.received.length}}</view>
            <view class="stat-label">我被服务</view>
          </view>
          <view class="stat-box tappable" bindtap="openEngagements" data-tab="pending">
            <view class="stat-value">{{engagementGroups.pending.length}}</view>
            <view class="stat-label">待确认</view>
          </view>
        </view>
      </view>

    </view>

    <view wx:if="{{showWechatProfileModal}}" class="wechat-profile-modal-mask" catchtouchmove="noop" bindtap="closeWechatProfileEditor">
      <view class="wechat-profile-modal" catchtap="noop">
        <view class="wechat-profile-header">
          <view class="wechat-profile-title">编辑资料</view>
          <view class="wechat-profile-close" bindtap="closeWechatProfileEditor">
            <view class="wechat-profile-close-line"></view>
            <view class="wechat-profile-close-line wechat-profile-close-line-alt"></view>
          </view>
        </view>
        <view class="wechat-profile-avatar-picker">
          <image wx:if="{{profileDraftAvatarUrl}}" class="wechat-profile-avatar-image" src="{{profileDraftAvatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="wechat-profile-avatar-placeholder">头像</view>
          <view class="wechat-profile-avatar-badge">编辑</view>
          <button class="wechat-profile-avatar-native-button" open-type="chooseAvatar" bindchooseavatar="onProfileModalChooseAvatar"></button>
        </view>
        <view class="wechat-profile-field">
          <view class="wechat-profile-label">昵称</view>
          <input
            class="wechat-profile-nickname-input"
            type="nickname"
            value="{{profileDraftNickname}}"
            bindinput="onProfileModalNicknameInput"
            placeholder="请输入昵称"
            maxlength="64"
          />
        </view>
        <button class="wechat-profile-confirm" bindtap="confirmWechatProfile" loading="{{savingWechatProfile}}">保存</button>
      </view>
    </view>
  </block>
</view>
