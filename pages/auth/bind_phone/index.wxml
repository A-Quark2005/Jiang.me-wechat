<view class="page">
  <view class="card">
    <view class="title">微信手机号绑定</view>
    <view class="subtitle">{{subtitleText}}</view>

    <view class="section">
      <view class="label">绑定票据</view>
      <view class="value {{bindingTicket ? '' : 'value-empty'}}">
        {{bindingTicket || '未收到 bindingTicket，请从 App 重新发起登录'}}
      </view>
    </view>

    <view class="section">
      <view class="label">后端地址</view>
      <view class="value">{{backendBaseUrl}}</view>
    </view>

    <view class="section">
      <view class="label">当前阶段</view>
      <view class="value">{{authStage || 'idle'}}</view>
    </view>

    <view wx:if="{{!completed}}" class="section">
      <view class="label">手机号</view>
      <input
        class="text-input"
        type="number"
        maxlength="11"
        placeholder="请输入 11 位手机号"
        value="{{phoneNumber}}"
        bindinput="handlePhoneInput"
      />
    </view>

    <view wx:if="{{errorMessage}}" class="status status-error">
      {{errorMessage}}
    </view>

    <view wx:if="{{successMessage}}" class="status status-success">
      {{successMessage}}
    </view>

    <view wx:if="{{debugMessage}}" class="section">
      <view class="label">调试信息</view>
      <view class="debug-box">{{debugMessage}}</view>
    </view>

    <button
      wx:if="{{!completed}}"
      class="primary-button"
      loading="{{submitting}}"
      disabled="{{!canAuthorize || submitting}}"
      bindtap="handleDirectBind"
    >
      {{submitting ? '正在提交手机号...' : '确认绑定手机号'}}
    </button>

    <button
      wx:if="{{completed}}"
      class="primary-button"
      bindtap="handleExitMiniProgram"
    >
      返回 APP 继续
    </button>

    <button
      class="secondary-button"
      bindtap="handleReloadFromLaunchOptions"
      disabled="{{submitting}}"
    >
      重新读取启动参数
    </button>
  </view>
</view>
