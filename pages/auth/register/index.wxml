<view class="page">
  <view class="hero">
    <view class="hero-title">注册讲了么账号</view>
    <view class="hero-subtitle">使用微信手机号创建账号，后续可在小程序管理资料和会议权益。</view>
  </view>

  <view class="card">
    <view class="section-title">手机号授权</view>
    <view class="section-subtitle">微信会先向你确认授权，授权成功后自动创建账号。</view>

    <view wx:if="{{errorMessage}}" class="error-box">{{errorMessage}}</view>
    <view wx:if="{{successMessage}}" class="success-box">{{successMessage}}</view>

    <button
      class="primary-button register-button"
      open-type="getPhoneNumber"
      bindgetphonenumber="handleGetPhoneNumber"
      loading="{{submitting}}"
      disabled="{{submitting}}"
    >
      {{submitting ? '正在注册' : '授权手机号并注册'}}
    </button>

    <button class="secondary-button register-button" bindtap="goHome" disabled="{{submitting}}">
      返回首页
    </button>
  </view>
</view>
