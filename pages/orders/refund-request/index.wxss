.refund-request-page {
  padding-bottom: 124rpx;
}

.refund-form-card {
  margin-top: 20rpx;
}

.refund-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 220rpx;
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  font-size: 28rpx;
  line-height: 1.6;
  color: #111827;
}

.evidence-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin-top: 20rpx;
}

.evidence-item,
.evidence-add {
  position: relative;
  overflow: hidden;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 10rpx;
  background: #f7f8fa;
}

.evidence-image {
  width: 100%;
  height: 100%;
}

.evidence-remove {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.58);
  font-size: 20rpx;
  line-height: 1.6;
  color: #ffffff;
}

.evidence-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #c7ced9;
  color: #6b7280;
}

.evidence-add-plus {
  font-size: 40rpx;
  line-height: 1;
}

.evidence-add-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.refund-submit-panel {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.refund-submit {
  width: 100%;
  min-height: 82rpx;
}
