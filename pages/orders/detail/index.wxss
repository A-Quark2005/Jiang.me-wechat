.order-detail-page {
  padding-top: 0;
  padding-bottom: 24rpx;
}

.order-detail-hero {
  margin-top: 20rpx;
  padding: 32rpx 32rpx 28rpx;
}

.order-detail-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.order-detail-title {
  min-width: 0;
  flex: 1;
  font-size: 34rpx;
  line-height: 1.45;
  font-weight: 500;
  color: #333333;
}

.order-detail-amount {
  margin-top: 24rpx;
  font-size: 64rpx;
  line-height: 1;
  font-weight: 600;
  color: #111827;
}

.order-detail-status-desc {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6b7280;
}

.detail-status-success {
  color: #0f9d58;
  background: #e8f7ee;
}

.detail-status-pending {
  color: #0071fe;
  background: #eef5ff;
}

.detail-status-expired {
  color: #9ca3af;
  background: #f3f4f6;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 24rpx;
}

.detail-row:first-of-type {
  padding-top: 20rpx;
}

.detail-row-label {
  width: 168rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  line-height: 1.6;
  color: #9ca3af;
}

.detail-row-value-wrap {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  gap: 16rpx;
}

.detail-row-value {
  min-width: 0;
  flex: 1;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: right;
  color: #1f2937;
  word-break: break-all;
}

.detail-row-copy {
  flex-shrink: 0;
  font-size: 24rpx;
  line-height: 1.6;
  color: #0071fe;
}
