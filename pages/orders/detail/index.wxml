<view class="page page-plain order-detail-page {{canConfirmTrialCompletion ? 'order-detail-page-with-bar' : ''}}">
  <view wx:if="{{loading}}" class="surface-card">
    <view class="section-title">正在读取订单详情</view>
    <view class="section-subtitle">请稍候。</view>
  </view>

  <view wx:elif="{{errorMessage}}" class="surface-card">
    <view class="section-title">读取失败</view>
    <view class="error-box">{{errorMessage}}</view>
    <button class="primary-button action-button" bindtap="loadDetail">重新加载</button>
  </view>

  <block wx:else>
    <view class="surface-card order-detail-hero">
      <view class="order-detail-hero-top">
        <view class="order-detail-title">{{titleText}}</view>
        <view class="pill {{statusClassName}}">{{statusText}}</view>
      </view>
      <view class="order-detail-amount">{{amountText}}</view>
      <view class="order-detail-status-desc">{{statusDescriptionText}}</view>
      <view wx:if="{{showAutoSettlementText}}" class="order-detail-settlement">{{autoSettlementText}}</view>
    </view>

    <view class="surface-card">
      <view class="detail-section-header">
        <view class="section-title">订单信息</view>
        <view
          wx:if="{{isContactDeposit}}"
          class="after-sale-toggle tappable"
          bindtap="toggleAfterSale"
        >申请售后</view>
      </view>
      <view wx:for="{{facts}}" wx:key="label" class="detail-row">
        <view class="detail-row-label">{{item.label}}</view>
        <view class="detail-row-value-wrap">
          <view class="detail-row-value">{{item.value}}</view>
          <view wx:if="{{item.copyable}}" class="detail-row-copy tappable" data-value="{{item.value}}" bindtap="copyField">复制</view>
        </view>
      </view>
      <view wx:if="{{afterSaleExpanded}}" class="after-sale-panel">
        <view wx:if="{{hasRefundRequest}}" class="after-sale-status">
          <view wx:if="{{refundStatusText}}" class="section-subtitle">{{refundStatusText}}</view>
          <view wx:if="{{refundReasonText}}" class="refund-reason">{{refundReasonText}}</view>
          <view wx:if="{{refundReviewerNote}}" class="refund-note">{{refundReviewerNote}}</view>
        </view>
        <view
          wx:elif="{{canRequestRefund}}"
          class="after-sale-option tappable"
          bindtap="openRefundRequest"
        >
          <view class="after-sale-option-main">
            <view class="after-sale-option-title">退款</view>
            <view class="after-sale-option-desc">试讲不满意，可提交退款申请，平台审核通过后原路退款。</view>
          </view>
          <view class="after-sale-option-action">申请</view>
        </view>
        <view wx:else class="section-subtitle">{{trialCompletionConfirmed ? '试课已完成，售后申请已关闭。' : '暂无可申请的售后服务'}}</view>
      </view>
    </view>

    <view wx:if="{{timeline.length > 0}}" class="surface-card">
      <view class="section-title">处理进度</view>
      <view wx:for="{{timeline}}" wx:key="label" class="detail-row">
        <view class="detail-row-label">{{item.label}}</view>
        <view class="detail-row-value">{{item.value}}</view>
      </view>
    </view>

    <view wx:if="{{canConfirmTrialCompletion}}" class="trial-completion-bar">
      <button
        class="primary-button trial-completion-button"
        loading="{{confirmingTrialCompletion}}"
        disabled="{{confirmingTrialCompletion}}"
        bindtap="confirmTrialCompletion"
      >确认完成试讲</button>
    </view>
  </block>
</view>
