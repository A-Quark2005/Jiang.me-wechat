<view class="page">
  <view class="hero">
    <view class="hero-title">订单记录</view>
    <view class="hero-subtitle">查看会议权益购买记录和支付状态。</view>
  </view>

  <view wx:if="{{loading}}" class="card">正在读取订单</view>
  <view wx:elif="{{errorMessage}}" class="card">
    <view class="error-box">{{errorMessage}}</view>
    <button class="primary-button action-button" bindtap="loadOrders">重新加载</button>
  </view>
  <view wx:elif="{{orders.length === 0}}" class="empty-box">暂无订单记录</view>

  <view wx:for="{{orders}}" wx:key="id" class="card">
    <view class="row">
      <view>
        <view class="section-title">{{item.title || item.productName || item.sourceType || '支付订单'}}</view>
        <view class="section-subtitle">{{item.createdAt || item.submittedAt || '暂无创建时间'}}</view>
      </view>
      <view class="pill">{{item.status || '未知'}}</view>
    </view>
    <view class="detail-line">金额：{{item.amountText || item.amount || '暂无金额'}}</view>
    <view class="detail-line">订单号：{{item.id || item.orderId}}</view>
  </view>
</view>
