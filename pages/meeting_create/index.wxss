@import "../home/index.wxss";

.meeting-create-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.meeting-create-hero {
  min-height: 654rpx;
}

.meeting-create-brand-copy {
  padding-top: 0;
}

.meeting-create-mascot {
  top: 164rpx;
  left: 264rpx;
  width: 480rpx;
  height: 450rpx;
  margin-top: 0;
  margin-right: 0;
}

.meeting-create-profile {
  margin-top: 0;
}

.meeting-create-entitlement {
  margin-top: 20px;
}

.meeting-create-card {
  margin-top: 8px;
}

.meeting-subject-block,
.meeting-time-block {
  margin-top: 0;
}

.meeting-subject-input {
  width: 100%;
  min-height: 60rpx;
  margin-top: 22rpx;
  padding: 0 0 22rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #000000;
}

.meeting-subject-input::placeholder {
  color: #bfbfbf;
}

.meeting-time-row {
  margin-top: 16rpx;
}

.meeting-time-arrow {
  width: 13.76rpx;
  height: 27.18rpx;
}

.meeting-create-hint {
  margin-top: 24rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #b0b8c9;
}

.meeting-submit-button {
  margin-top: 36rpx;
}

.hour-pass-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 32rpx;
  background: rgba(0, 0, 0, 0.36);
}

.hour-pass-modal {
  width: 100%;
  max-width: 686rpx;
  padding: 40rpx 32rpx 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
}

.hour-pass-title {
  font-size: 32rpx;
  line-height: 44rpx;
  color: #1f2937;
  text-align: center;
}

.hour-pass-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #6b7280;
  text-align: center;
}

.hour-pass-stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 32rpx;
}

.hour-pass-stepper-button {
  width: 88rpx;
  min-width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border-radius: 20rpx;
  background: #f3f4f6;
  color: #111827;
  font-size: 40rpx;
  line-height: 88rpx;
}

.hour-pass-stepper-value {
  flex: 1;
  min-height: 88rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  text-align: center;
}

.hour-pass-hours {
  font-size: 30rpx;
  line-height: 42rpx;
  color: #111827;
}

.hour-pass-price {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #0071fe;
}

.hour-pass-desc {
  margin-top: 24rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: #9ca3af;
  text-align: center;
}

.hour-pass-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 32rpx;
}

.hour-pass-cancel,
.hour-pass-confirm {
  height: 88rpx;
  margin: 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 88rpx;
}

.hour-pass-cancel {
  background: #f3f4f6;
  color: #374151;
}

.hour-pass-confirm {
  background: #0071fe;
  color: #ffffff;
}
