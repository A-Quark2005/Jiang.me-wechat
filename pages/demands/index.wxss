.demands-page {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.demand-tabs {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin: 16rpx 0;
  padding: 8rpx;
  border-radius: 12rpx;
  background: #ffffff;
}

.demand-tab {
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  color: #667085;
  font-size: 26rpx;
}

.demand-tab.active {
  color: #ffffff;
  background: #0071fe;
}

.demand-feed-hint {
  margin: 4rpx 8rpx 16rpx;
  color: #8b95a7;
  font-size: 24rpx;
  line-height: 36rpx;
}

.demand-card {
  box-shadow: none;
  border: 1rpx solid #edf0f5;
}

.demand-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.demand-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 600;
  color: #152033;
}

.demand-price {
  flex-shrink: 0;
  color: #0071fe;
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 600;
}

.demand-desc {
  margin-top: 8rpx;
  color: #8b95a7;
  font-size: 26rpx;
  line-height: 38rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.demand-org-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.demand-org-chip {
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #eef5ff;
  color: #0071fe;
  font-size: 22rpx;
  line-height: 44rpx;
}

.demand-requirement {
  margin-top: 16rpx;
  color: #8b95a7;
  font-size: 24rpx;
  line-height: 36rpx;
}

.demand-card-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  color: #b0b8c9;
  font-size: 24rpx;
}

.demand-empty {
  min-height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b0b8c9;
}

.demand-create-button {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  height: 96rpx;
  border-radius: 8rpx;
  z-index: 20;
}
