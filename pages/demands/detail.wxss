.demand-detail-page {
  padding-top: 16rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.demand-empty {
  min-height: 260rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b0b8c9;
}

.demand-overview,
.selected-card,
.candidates-card,
.application-state {
  box-shadow: none;
  border: 1rpx solid #edf0f5;
}

.overview-top,
.section-head,
.selected-row,
.candidate-summary,
.candidate-name-row,
.candidate-actions {
  display: flex;
  align-items: center;
}

.overview-top,
.section-head,
.selected-row {
  justify-content: space-between;
  gap: 20rpx;
}

.detail-status {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #0071fe;
  background: #eef5ff;
  font-size: 22rpx;
}

.overview-price {
  color: #0071fe;
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 600;
}

.overview-title {
  margin-top: 18rpx;
  color: #152033;
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 700;
}

.overview-meta {
  margin-top: 8rpx;
  color: #667085;
  font-size: 26rpx;
  line-height: 38rpx;
}

.overview-desc {
  margin-top: 18rpx;
  color: #667085;
  font-size: 28rpx;
  line-height: 42rpx;
  white-space: pre-wrap;
}

.detail-org-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}

.detail-org-chip {
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #f7f9fc;
  color: #667085;
  font-size: 22rpx;
  line-height: 44rpx;
}

.detail-requirement {
  margin-top: 20rpx;
  color: #8b95a7;
  font-size: 24rpx;
  line-height: 36rpx;
}

.overview-cancel {
  margin-top: 24rpx;
}

.plain-danger-button {
  height: 72rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: #d92d20;
  font-size: 26rpx;
  line-height: 72rpx;
  text-align: left;
}

.plain-danger-button::after {
  border: 0;
}

.section-title {
  color: #152033;
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 700;
}

.section-subtitle {
  margin-top: 4rpx;
  color: #8b95a7;
  font-size: 24rpx;
  line-height: 34rpx;
}

.selected-avatar,
.candidate-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #eef5ff;
  flex-shrink: 0;
}

.selected-main,
.candidate-main {
  flex: 1;
  min-width: 0;
}

.selected-name,
.candidate-name {
  color: #152033;
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 600;
}

.selected-phone,
.candidate-phone {
  margin-top: 4rpx;
  color: #0071fe;
  font-size: 26rpx;
  line-height: 36rpx;
}

.selected-copy {
  width: 180rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.candidate-empty {
  min-height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b0b8c9;
  font-size: 26rpx;
}

.candidate-card {
  padding: 24rpx 0;
  border-top: 1rpx solid #f1f3f6;
}

.candidate-card:first-of-type {
  border-top: 0;
}

.candidate-card.candidate-selected {
  background: linear-gradient(90deg, rgba(0, 113, 254, 0.06), rgba(0, 113, 254, 0));
}

.candidate-card.candidate-rejected {
  opacity: 0.72;
}

.candidate-summary {
  align-items: flex-start;
  gap: 18rpx;
}

.candidate-name-row {
  gap: 12rpx;
}

.candidate-badge {
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #eef5ff;
  color: #0071fe;
  font-size: 20rpx;
  line-height: 36rpx;
  flex-shrink: 0;
}

.candidate-badge.muted {
  background: #f2f4f7;
  color: #8b95a7;
}

.candidate-meta,
.candidate-message {
  margin-top: 6rpx;
  color: #8b95a7;
  font-size: 24rpx;
  line-height: 34rpx;
}

.candidate-message {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.candidate-actions {
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 18rpx;
}

.candidate-secondary,
.candidate-primary {
  width: 180rpx;
  height: 72rpx;
  font-size: 26rpx;
}

.resume-panel {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #f7f9fc;
}

.resume-section + .resume-section {
  margin-top: 26rpx;
}

.resume-section-title {
  color: #152033;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 600;
}

.resume-text,
.resume-line-meta,
.resume-empty {
  margin-top: 6rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 36rpx;
  white-space: pre-wrap;
}

.resume-line {
  padding: 14rpx 0;
  border-top: 1rpx solid #edf0f5;
}

.resume-line:first-of-type {
  border-top: 0;
}

.resume-line-title {
  color: #152033;
  font-size: 26rpx;
  line-height: 38rpx;
  font-weight: 500;
}

.detail-bottom-space {
  height: 110rpx;
}

.detail-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.05);
  display: flex;
  gap: 18rpx;
}

.detail-primary {
  height: 88rpx;
  border-radius: 8rpx;
  flex: 1;
}

.detail-share {
  flex: 0 0 220rpx;
}

.detail-share-only {
  flex: 1;
}

.share-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 500px;
  height: 400px;
}
