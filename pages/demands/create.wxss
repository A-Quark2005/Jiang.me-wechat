.demand-form-page {
  padding-top: 16rpx;
  padding-bottom: calc(360rpx + env(safe-area-inset-bottom));
}

.form-card {
  box-shadow: none;
  border: 1rpx solid #edf0f5;
}

.form-label,
.form-title {
  font-size: 30rpx;
  line-height: 42rpx;
  color: #333333;
  font-weight: 500;
}

.form-label + .form-input,
.form-label + .form-textarea {
  margin-top: 14rpx;
}

.form-label:not(:first-child) {
  margin-top: 28rpx;
}

.form-input,
.form-textarea {
  width: 100%;
  border-radius: 8rpx;
  background: #f7f9fc;
  color: #152033;
  font-size: 28rpx;
}

.form-input {
  height: 88rpx;
  padding: 0 20rpx;
}

.form-textarea {
  min-height: 180rpx;
  padding: 18rpx 20rpx;
}

.form-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.form-meta,
.form-loading {
  color: #9ca3af;
  font-size: 24rpx;
  line-height: 36rpx;
}

.org-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 18rpx;
}

.org-option {
  padding: 18rpx 20rpx;
  border-radius: 8rpx;
  background: #f7f9fc;
  border: 1rpx solid transparent;
}

.org-option.active {
  border-color: #0071fe;
  background: #eef5ff;
}

.org-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.org-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #152033;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 500;
}

.org-type-label {
  flex-shrink: 0;
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #667085;
  font-size: 22rpx;
  line-height: 38rpx;
}

.org-option.active .org-type-label {
  color: #0071fe;
}

.org-rate {
  margin-top: 4rpx;
  color: #8b95a7;
  font-size: 24rpx;
  line-height: 34rpx;
}

.settlement-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 21;
  padding: 22rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.settlement-rate-row,
.settlement-bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.settlement-title {
  color: #333333;
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 500;
}

.settlement-hint {
  margin-top: 2rpx;
  color: #9ca3af;
  font-size: 24rpx;
  line-height: 34rpx;
}

.settlement-rate {
  flex-shrink: 0;
  color: #0071fe;
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 600;
}

.settlement-slider-area {
  margin-top: 12rpx;
}

.settlement-free-rate {
  height: 94rpx;
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  background: #f7f9fc;
  color: #0071fe;
  font-size: 26rpx;
  font-weight: 500;
}

.fee-slider {
  margin: 0 -8rpx;
}

.fee-range-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #9ca3af;
  font-size: 24rpx;
  line-height: 34rpx;
}

.settlement-bottom-row {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf0f5;
}

.bottom-total {
  width: 200rpx;
  display: flex;
  flex-direction: column;
  color: #8b95a7;
  font-size: 24rpx;
}

.bottom-price {
  color: #0071fe;
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 600;
}

.bottom-submit {
  flex: 1;
  height: 88rpx;
  border-radius: 8rpx;
}

.bottom-submit[disabled] {
  color: #ffffff;
  background: #b7d5ff;
}
