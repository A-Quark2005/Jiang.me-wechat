.demand-form-page {
  padding-top: 16rpx;
  padding-bottom: calc(360rpx + env(safe-area-inset-bottom));
}

.form-card {
  box-shadow: none;
  border: 1rpx solid #edf0f5;
}

.form-label,
.form-title {
  font-size: 30rpx;
  line-height: 42rpx;
  color: #333333;
  font-weight: 500;
}

.form-label + .form-input,
.form-label + .form-textarea {
  margin-top: 14rpx;
}

.form-label:not(:first-child) {
  margin-top: 28rpx;
}

.form-input,
.form-textarea {
  width: 100%;
  border-radius: 8rpx;
  background: #f7f9fc;
  color: #152033;
  font-size: 28rpx;
}

.form-input {
  height: 88rpx;
  padding: 0 20rpx;
}

.form-textarea {
  min-height: 180rpx;
  padding: 18rpx 20rpx;
}

.form-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.form-meta,
.form-loading {
  color: #9ca3af;
  font-size: 24rpx;
  line-height: 36rpx;
}

.org-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 14rpx;
}

.scope-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 8rpx;
  background: #f7f9fc;
  border: 1rpx solid transparent;
}

.scope-card.active {
  border-color: #0071fe;
  background: #eef5ff;
}

.scope-title {
  color: #152033;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 500;
}

.scope-desc {
  margin-top: 4rpx;
  color: #8b95a7;
  font-size: 24rpx;
  line-height: 34rpx;
}

.org-filter-strip {
  margin-top: 18rpx;
  padding: 0;
  background: transparent;
}

.org-option {
  padding: 18rpx 20rpx;
  border-radius: 8rpx;
  background: #f7f9fc;
  border: 1rpx solid transparent;
}

.org-option.active {
  border-color: #0071fe;
  background: #eef5ff;
}

.org-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.org-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #152033;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 500;
}

.org-type-label {
  flex-shrink: 0;
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #667085;
  font-size: 22rpx;
  line-height: 38rpx;
}

.org-option.active .org-type-label {
  color: #0071fe;
}

.org-select-icon {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 2rpx solid #c8d0dc;
  box-sizing: border-box;
}

.org-select-icon.active {
  position: relative;
  background: #0071fe;
  border-color: #0071fe;
}

.org-select-icon.active::after {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 5rpx;
  width: 10rpx;
  height: 16rpx;
  border-right: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(45deg);
}

.org-rate {
  margin-top: 4rpx;
  color: #8b95a7;
  font-size: 24rpx;
  line-height: 34rpx;
}

.limit-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.limit-option {
  height: 76rpx;
  border-radius: 8rpx;
  background: #f7f9fc;
  border: 1rpx solid transparent;
  color: #667085;
  font-size: 28rpx;
  line-height: 76rpx;
  text-align: center;
}

.limit-option.active {
  border-color: #0071fe;
  background: #eef5ff;
  color: #0071fe;
  font-weight: 600;
}

.settlement-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 21;
  padding: 22rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.settlement-rate-row,
.settlement-bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.settlement-title {
  color: #333333;
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 500;
}

.settlement-hint {
  margin-top: 2rpx;
  color: #9ca3af;
  font-size: 24rpx;
  line-height: 34rpx;
}

.settlement-rate-control {
  flex-shrink: 0;
  min-width: 210rpx;
  padding: 12rpx 18rpx;
  border-radius: 8rpx;
  background: #eef5ff;
  text-align: right;
}

.settlement-rate {
  color: #0071fe;
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 600;
}

.settlement-rate-hint {
  margin-top: 2rpx;
  color: #6b9ef6;
  font-size: 22rpx;
  line-height: 30rpx;
}

.settlement-bottom-row {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf0f5;
}

.bottom-total {
  width: 300rpx;
  display: flex;
  flex-direction: column;
  color: #8b95a7;
  font-size: 24rpx;
}

.bottom-price {
  color: #0071fe;
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 600;
}

.bottom-note {
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 30rpx;
}

.bottom-submit {
  flex: 1;
  height: 88rpx;
  border-radius: 8rpx;
}

.bottom-submit[disabled] {
  color: #ffffff;
  background: #b7d5ff;
}
