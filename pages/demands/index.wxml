<view class="page demands-page">
  <view class="demand-tabs">
    <view class="demand-tab {{activeTab === 'feed' ? 'active' : ''}}" data-tab="feed" bindtap="switchTab">待投递</view>
    <view class="demand-tab {{activeTab === 'mine' ? 'active' : ''}}" data-tab="mine" bindtap="switchTab">我发布的</view>
  </view>

  <view wx:if="{{loading}}" class="surface-card demand-empty">正在读取需求</view>
  <view wx:elif="{{errorMessage}}" class="surface-card demand-empty">{{errorMessage}}</view>

  <view wx:else>
    <view wx:if="{{activeTab === 'feed'}}">
      <view class="demand-feed-hint">这里只展示未收到简历的需求，收满后会自动撤下</view>
      <view wx:if="{{feed.length === 0}}" class="surface-card demand-empty">暂无未收到简历的需求</view>
      <view wx:for="{{feed}}" wx:key="id" class="surface-card demand-card tappable" data-id="{{item.id}}" bindtap="openDemand">
        <view class="demand-card-head">
          <view class="demand-title">{{item.title}}</view>
          <view class="demand-price">{{item.feePerHourText}}</view>
        </view>
        <view wx:if="{{item.showPoster}}" class="demand-poster-row">
          <image class="demand-poster-avatar" src="{{item.poster.avatarUrlResolved}}" mode="aspectFill" data-url="{{item.poster.avatarUrlResolved}}" catchtap="previewPosterAvatar"></image>
          <view class="demand-poster-name">{{item.poster.displayNameText}}</view>
        </view>
        <view class="demand-desc">{{item.descriptionText}}</view>
        <view class="demand-org-row" wx:if="{{item.hasOrganizations}}">
          <view wx:for="{{item.organizations}}" wx:for-item="org" wx:key="id" class="demand-org-chip">{{org.name}}</view>
        </view>
        <view wx:else class="demand-requirement">{{item.requirementText}}</view>
        <view class="demand-card-foot">
          <text>{{item.applicationProgressText}}</text>
          <text>{{item.applyStatusText}}</text>
        </view>
      </view>
    </view>

    <view wx:else>
      <view wx:if="{{mine.length === 0}}" class="surface-card demand-empty">还没有发布需求</view>
      <view wx:for="{{mine}}" wx:key="id" class="surface-card demand-card tappable" data-id="{{item.id}}" bindtap="openDemand">
        <view class="demand-card-head">
          <view class="demand-title">{{item.title}}</view>
          <view class="demand-price">{{item.statusText}}</view>
        </view>
        <view class="demand-desc">{{item.feePerHourText}}，试讲定金 {{item.amountText}}，{{item.applicationProgressText}}</view>
        <view class="demand-org-row" wx:if="{{item.hasOrganizations}}">
          <view wx:for="{{item.organizations}}" wx:for-item="org" wx:key="id" class="demand-org-chip">{{org.name}}</view>
        </view>
        <view wx:else class="demand-requirement">{{item.requirementText}}</view>
      </view>
    </view>
  </view>

  <button wx:if="{{createEntryHidden === 0}}" class="primary-button demand-create-button" bindtap="openCreate">发布需求</button>
</view>
