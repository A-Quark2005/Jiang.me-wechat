<view class="page page-plain members-page">
  <view wx:if="{{organization}}" class="surface-card members-org-card">
    <image wx:if="{{organization.logoUrl}}" class="members-org-logo" src="{{organization.logoUrl}}" mode="aspectFit"></image>
    <view wx:else class="members-org-logo fallback">{{organizationInitial}}</view>
    <view class="members-main">
      <view class="members-org-title">{{organization.name}}</view>
      <view class="members-org-meta">已认证该组织的人</view>
    </view>
    <view class="members-share-button">
      <image class="members-share-icon" src="/assets/ui/share-outline-black.svg" mode="aspectFit"></image>
      <view class="members-share-hint">转发页面</view>
      <button class="members-share-native" aria-label="share" bindtap="showShareOptions"></button>
    </view>
  </view>

  <view wx:if="{{loading && members.length === 0}}" class="surface-card members-empty">正在读取成员</view>
  <view wx:elif="{{errorMessage && members.length === 0}}" class="surface-card">
    <view class="section-title">读取失败</view>
    <view class="error-box">{{errorMessage}}</view>
    <button class="primary-button action-button" bindtap="reload">重新加载</button>
  </view>

  <view wx:else class="members-list">
    <view wx:if="{{members.length === 0}}" class="surface-card members-empty">暂无公开资料</view>
    <view wx:for="{{members}}" wx:key="id" class="surface-card member-card">
      <view class="member-summary">
        <image class="member-avatar" src="{{item.avatarUrlResolved}}" mode="aspectFill" data-url="{{item.avatarUrlResolved}}" catchtap="previewAvatar"></image>
        <view class="member-main">
          <view class="member-name">{{item.displayName}}</view>
          <view class="member-meta">{{item.verifiedText}}</view>
        </view>
      </view>
      <view class="member-actions">
        <button class="ghost-button member-action" data-id="{{item.id}}" bindtap="toggleMemberResume">{{item.resumeButtonText}}</button>
        <button class="primary-button member-action" data-id="{{item.id}}" bindtap="openPublicResume">详情</button>
      </view>
      <view wx:if="{{item.resumeExpanded}}" class="member-resume-panel">
        <view class="member-resume-section">
          <view class="member-resume-title">自我介绍</view>
          <text selectable="{{true}}" class="member-resume-text">{{item.selfIntroductionText}}</text>
        </view>
      </view>
    </view>
    <button wx:if="{{hasMore}}" class="secondary-button members-more" loading="{{loadingMore}}" bindtap="loadMore">加载更多</button>
  </view>
</view>

<view wx:if="{{sharePanelVisible}}" class="wechat-share-mask" catchtap="hideShareOptions">
  <view class="wechat-share-sheet" catchtap="noop">
    <button class="wechat-share-item" open-type="share">{{shareMenuText.friend}}</button>
    <view class="wechat-share-line"></view>
    <button class="wechat-share-item" loading="{{miniProgramCodeLoading}}" disabled="{{miniProgramCodeLoading}}" bindtap="handleMiniProgramCode">{{shareMenuText.code}}</button>
    <view class="wechat-share-gap"></view>
    <button class="wechat-share-cancel" bindtap="hideShareOptions">{{shareMenuText.cancel}}</button>
  </view>
</view>
