.members-page {
  min-height: 100vh;
  padding: 18rpx 16px 32rpx;
  box-sizing: border-box;
}

.members-org-card,
.member-card {
  display: flex;
  gap: 20rpx;
}

.members-org-card {
  align-items: center;
}

.members-org-card {
  position: relative;
  min-height: 150rpx;
  padding: 24rpx 28rpx;
  padding-right: 112rpx;
}

.members-org-logo {
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
}

.members-org-logo.fallback,
.member-avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef5ff;
  color: #0071fe;
  font-weight: 600;
}

.members-org-logo.fallback {
  border-radius: 16rpx;
  font-size: 32rpx;
}

.members-main {
  min-width: 0;
  flex: 1;
}

.members-share-button {
  position: absolute;
  right: 28rpx;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #111111;
  line-height: 1;
  flex-shrink: 0;
  transform: translateY(-50%);
}

.members-share-icon {
  display: block;
  width: 44rpx;
  height: 44rpx;
}

.members-share-hint {
  position: absolute;
  left: 50%;
  top: 62rpx;
  transform: translateX(-50%);
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 30rpx;
  white-space: nowrap;
}

.members-share-native {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  opacity: 0;
}

.members-share-native::after {
  border: 0;
}

.members-org-title,
.member-name {
  color: #152033;
  font-weight: 600;
}

.members-org-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 32rpx;
  line-height: 46rpx;
}

.members-org-meta,
.member-meta {
  margin-top: 4rpx;
  color: #9ca3af;
  font-size: 24rpx;
  line-height: 34rpx;
}

.members-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}

.member-card {
  min-height: 132rpx;
  padding: 24rpx 28rpx;
  flex-direction: column;
  align-items: stretch;
  gap: 0;
}

.member-summary {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.member-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #eef5ff;
  flex-shrink: 0;
}

.member-avatar.fallback {
  font-size: 30rpx;
}

.member-main {
  min-width: 0;
  flex: 1;
}

.member-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  line-height: 42rpx;
}

.members-empty {
  min-height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b0b8c9;
  font-size: 26rpx;
}

.members-more {
  width: 100%;
  height: 82rpx;
  margin-top: 8rpx;
}

.member-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.member-action {
  flex: 1;
  width: auto !important;
  height: 80rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 80rpx;
}

.member-resume-panel {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #f7f9fc;
}

.member-resume-title {
  color: #152033;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 600;
}

.member-resume-text {
  margin-top: 6rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 36rpx;
  white-space: pre-wrap;
}

.wechat-share-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.58);
}

.wechat-share-sheet {
  width: 100%;
  overflow: hidden;
  border-radius: 28rpx 28rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: #ffffff;
}

.wechat-share-item,
.wechat-share-cancel {
  display: flex;
  width: 100% !important;
  min-width: 0;
  max-width: none;
  height: 118rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  background: #ffffff;
  color: #111111;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 118rpx;
  text-align: center;
}

.wechat-share-item::after,
.wechat-share-cancel::after {
  border: 0;
}

.wechat-share-line {
  width: 100%;
  height: 1rpx;
  margin: 0;
  padding: 0;
  background: #e5e5e5;
  transform: scaleY(0.5);
  transform-origin: 0 0;
}

.wechat-share-gap {
  width: 100%;
  height: 18rpx;
  background: #f2f2f2;
}

.wechat-share-cancel {
  color: #333333;
}
