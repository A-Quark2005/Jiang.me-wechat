<view class="page">
  <view class="surface-card bind-card">
    <view class="status-icon {{status}}">{{iconText}}</view>
    <text class="title">{{title}}</text>
    <text class="message">{{message}}</text>
    <button
      wx:if="{{!bound}}"
      class="primary-button action"
      open-type="getPhoneNumber"
      loading="{{binding}}"
      disabled="{{binding}}"
      bindgetphonenumber="handleGetPhoneNumber"
    >授权手机号</button>
    <button
      wx:if="{{bound}}"
      class="secondary-button action"
      bindtap="returnToApp"
    >返回 APP 继续</button>
  </view>
</view>
